    function ItemByWarehouseSelectionChangedProcessCard(s, e) {
        var key = s.GetRowKey(e.visibleIndex);
        if (s.IsRowSelectedOnPage(e.visibleIndex)) {
            if (SortingItemProcessCard.GetValue() == null) {
                SortingItemProcessCard.SetValue(key);
            } else {
                SortingItemProcessCard.SetValue(SortingItemProcessCard.GetValue() + ',' + key);
            }
        } else {
            var sort = SortingItemProcessCard.GetValue();
            sort = sort.replace(key, "");
            sort = sort.replace(",,", ", ");
            SortingItemProcessCard.SetValue(sort);
        }
    }

    function OnClickChoose_CflItemByWarehouseProcessCard(s, e) {
        gvCflItemByWarehouseListProcessCard.GetSelectedFieldValues('ItemCode', GetSelectedFieldValuesCallback_CflItemByWarehouse);
    }

    function GetSelectedFieldValuesCallback_CflItemByWarehouse(values) {
        cflItemByWarehousePopupListProcessCard.Hide();

        key = Id.GetValue();
        console.log(SortingItemProcessCard.GetValue()); 

        $.ajax({
            type: "POST",
            url: '@Url.Action("ChooseItem", "ProcessCard")',
            data: {
                Id: key,
                Data: values,
                Sorting: SortingItemProcessCard.GetValue(),
            },
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                gvDetail.PerformCallback();
                OnSuccessMsgBox();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete();
            }
        });

    }

</script>
