@using Models;
@using Models.Production;
@model List<Models.Production.ProductionTaskActivityBatchModel>

@{
    var Id = Convert.ToInt64(Request["cbId"]);
    var DetId = Convert.ToInt64(Request["cbDetId"]);
    var ActivityDetId = Convert.ToInt64(Request["cbActivityDetId"]);

    int userId = (int)Session["userId"];

    if (ViewBag.Id != null)
    {
        Id = ViewBag.Id;
    }
    if (ViewBag.DetId != null)
    {
        DetId = ViewBag.DetId;
    }
    if (ViewBag.ActivityDetId != null)
    {
        ActivityDetId = ViewBag.ActivityDetId;
    }

    // Batch hanya boleh diubah selama activity belum Finished.
    ViewBag.ReadOnly = false;
    string activityStatus = Models._Ef.DbProvider.dbApp.Database.SqlQuery<string>(
        "SELECT TOP 1 T0.\"Status\" FROM \"Tx_ProductionTask_Activity\" T0 WHERE T0.\"DetId\"=:p0", DetId).FirstOrDefault();
    if (activityStatus == "Finished")
    {
        ViewBag.ReadOnly = true;
    }

    // ItemCode + WhsCode item yang popup batch nya dibuka (kunci DetId = Tx_ProductionTask_Item).
    // Dicari dari tabel item supaya drop down batch (GeneralGetList.GetBatch) tahu item apa.
    string batchItemCode = Models._Ef.DbProvider.dbApp.Database.SqlQuery<string>(
        "SELECT TOP 1 T0.\"ItemCode\" FROM \"Tx_ProductionTask_Item\" T0 WHERE T0.\"DetId\"=:p0", DetId).FirstOrDefault() ?? "";
    string batchWhsCode = Models._Ef.DbProvider.dbApp.Database.SqlQuery<string>(
        "SELECT TOP 1 T0.\"WhsCode\" FROM \"Tx_ProductionTask_Item\" T0 WHERE T0.\"DetId\"=:p0", DetId).FirstOrDefault() ?? "";

    // Daftar batch SAP (OBTN) yang tersedia untuk item + gudang ini, menampilkan Code dan Quantity.
    System.Data.DataTable obtnBatchList = new System.Data.DataTable();
    if (!string.IsNullOrEmpty(batchItemCode))
    {
        obtnBatchList = Models._Utils.GeneralGetList.GetBatch(batchItemCode, batchWhsCode);
    }

    // Item Direction 'In' belum punya batch di gudang (barangnya justru baru dihasilkan),
    // jadi kolom Batch disembunyikan -- dan otomatis tidak boleh jadi wajib isi.
    string batchDirection = Models._Ef.DbProvider.dbApp.Database.SqlQuery<string>(
        "SELECT TOP 1 T0.\"Direction\" FROM \"Tx_ProductionTask_Item\" T0 WHERE T0.\"DetId\"=:p0", DetId).FirstOrDefault() ?? "";
    bool isDirectionIn = string.Equals(batchDirection, "In", StringComparison.OrdinalIgnoreCase);
}

@Html.DevExpress().GridView(settings =>
{

    settings.Name = "gvContentBatchList";
    settings.KeyFieldName = "BatchId";
    settings.Width = Unit.Percentage(100);
    settings.CallbackRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabBatchListPartial", Id = Id, DetId = DetId, ActivityDetId = ActivityDetId };
    settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabBatchListAddNewRow", Id = Id, DetId = DetId, ActivityDetId = ActivityDetId };
    settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabBatchListUpdateRow", Id = Id, DetId = DetId, ActivityDetId = ActivityDetId };
    settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabBatchListDeleteRow", Id = Id, DetId = DetId, ActivityDetId = ActivityDetId };

    settings.SettingsBehavior.ConfirmDelete = true;
    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;
    settings.Settings.VerticalScrollableHeight = 200;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;

    settings.SettingsEditing.Mode = GridViewEditingMode.Inline;
    settings.SettingsEditing.NewItemRowPosition = GridViewNewItemRowPosition.Bottom;

    settings.CommandColumn.Visible = true;
    settings.CommandColumn.ShowNewButtonInHeader = true;
    settings.CommandColumn.ShowEditButton = true;
    settings.CommandColumn.ShowDeleteButton = true;

    settings.CommandColumn.Width = 100;
    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;

    settings.Settings.ShowFilterRow = false;
    settings.Settings.ShowFilterRowMenu = false;

    settings.Columns.Add("BatchId", "BatchId").Visible = false;

    settings.Columns.Add(column =>
    {
        column.FieldName = "Id";
        column.Caption = "Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemDetId";
        column.Caption = "Item Det Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ActivityDetId";
        column.Caption = "Activity Det Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "RowNo";
        column.Caption = "Row No";
        column.Width = 60;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Batch";
        column.Name = "Batch";
        column.Caption = "Batch";

        // Dropdown daftar batch SAP (OBTN) per ItemCode + WhsCode item yang popup nya dibuka.
        column.ColumnType = MVCxGridViewColumnType.ComboBox;

        // Direction 'In' -> kolom disembunyikan (width 0).
        column.Width = isDirectionIn ? 0 : 200;

        var cbo = column.PropertiesEdit as ComboBoxProperties;
        cbo.DataSource = obtnBatchList;
        cbo.TextField = "Code";
        cbo.ValueField = "Code";
        cbo.ValueType = typeof(string);
        cbo.DropDownStyle = DropDownStyle.DropDownList;
        cbo.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

        // Kalau kolomnya disembunyikan, jangan dijadikan wajib -- baris tidak akan pernah
        // bisa disimpan karena user tidak punya cara mengisinya.
        cbo.ValidationSettings.RequiredField.IsRequired = !isDirectionIn;
        cbo.ValidationSettings.RequiredField.ErrorText = "Batch is required";
        cbo.ValidationSettings.Display = Display.Dynamic;
        cbo.ClientInstanceName = settings.Name + "_" + column.FieldName;
    });

    settings.Columns.Add(column =>
    {
        // Kolom milik tabel batch sendiri, bisa diinput untuk Direction 'In' maupun 'Out'.
        column.FieldName = "Quantity";
        column.Name = "Quantity";
        column.Caption = "Quantity";
        column.HeaderStyle.HorizontalAlign = HorizontalAlign.Right;
        column.Width = 100;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = ViewBag.ReadOnly;

        column.ColumnType = MVCxGridViewColumnType.SpinEdit;
        var txt = column.PropertiesEdit as SpinEditProperties;
        txt.NumberType = SpinEditNumberType.Integer;
        txt.DisplayFormatString = "#,###";
        txt.DisplayFormatInEditMode = true;
        txt.AllowMouseWheel = false;
        txt.SpinButtons.ShowIncrementButtons = false;

        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ValidationSettings.RequiredField.IsRequired = true;
        txt.ValidationSettings.RequiredField.ErrorText = "Quantity is required";
        txt.ValidationSettings.Display = Display.Dynamic;
        txt.Style.HorizontalAlign = HorizontalAlign.Right;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "AdmissionDate";
        column.Name = "AdmissionDate";
        column.Caption = "Admission Date";

        column.ColumnType = MVCxGridViewColumnType.DateEdit;
        column.Width = 120;
        column.ReadOnly = ViewBag.ReadOnly;

        var txt = column.PropertiesEdit as DateEditProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#E0E0E0");
        txt.DisplayFormatString = "dd/MM/yyyy";
        txt.EditFormatString = "dd/MM/yyyy";
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
    });

    settings.Columns.Add(column =>
    {
        // Bisa diinput untuk Direction 'In' maupun 'Out'.
        column.FieldName = "Netto";
        column.Name = "Netto";
        column.Caption = "Netto";
        column.HeaderStyle.HorizontalAlign = HorizontalAlign.Right;
        column.Width = 100;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = ViewBag.ReadOnly;

        column.ColumnType = MVCxGridViewColumnType.SpinEdit;
        var txt = column.PropertiesEdit as SpinEditProperties;
        txt.NumberType = SpinEditNumberType.Float;
        txt.DisplayFormatString = "#,###";
        txt.DisplayFormatInEditMode = true;
        txt.AllowMouseWheel = false;
        txt.SpinButtons.ShowIncrementButtons = false;

        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ValidationSettings.RequiredField.IsRequired = true;
        txt.ValidationSettings.RequiredField.ErrorText = "Netto is required";
        txt.ValidationSettings.Display = Display.Dynamic;
        txt.Style.HorizontalAlign = HorizontalAlign.Right;
    });

    settings.ClientSideEvents.BeginCallback = string.Format("function(s, e) {{ gvContentBatchListOnBeginCallback(s, e, {0}, {1}); }}", Id, DetId);
    settings.ClientSideEvents.EndCallback = string.Format("function(s, e) {{ gvContentBatchListOnEndCallback(s, e, {0}, {1}); }}", Id, DetId);

    settings.InitNewRow = (s, e) =>
    {
        e.NewValues["Id"] = Id;
        e.NewValues["ItemDetId"] = DetId;
        e.NewValues["ActivityDetId"] = ActivityDetId;

        e.NewValues["AdmissionDate"] = DateTime.Today;
    };

}).Bind(Model).GetHtml()
