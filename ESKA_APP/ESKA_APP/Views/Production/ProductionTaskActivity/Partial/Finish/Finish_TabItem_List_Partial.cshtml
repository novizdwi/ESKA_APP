@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Models;
@model List<Models.Production.ProductionTaskDetailItemModel>

@{
    var Id = Convert.ToInt64(Request["cbId"]);
    var ActivityDetId = Convert.ToInt64(Request["cbActivityDetId"]);
    int userId = (int)Session["userId"];

    if (ViewBag.Id != null){ Id = ViewBag.Id; }
    if (ViewBag.ActivityDetId != null) { ActivityDetId = ViewBag.ActivityDetId; }
}

@Html.DevExpress().GridView(settings =>
{

    settings.Name = "gvContentItemList";
    settings.KeyFieldName = "DetId";
    settings.Width = Unit.Percentage(100);
    settings.CallbackRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListPartial", Id = Id, ActivityDetId = ActivityDetId };
    settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListAddNewRow", Id = Id, ActivityDetId = ActivityDetId };
    settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListUpdateRow", Id = Id, ActivityDetId = ActivityDetId };
    settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListDeleteRow", Id = Id, ActivityDetId = ActivityDetId };

    settings.SettingsBehavior.ConfirmDelete = true;
    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;
    settings.Settings.VerticalScrollableHeight = 200;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;

    settings.SettingsEditing.Mode = GridViewEditingMode.Inline;
    settings.SettingsEditing.BatchEditSettings.EditMode = GridViewBatchEditMode.Row;
    settings.SettingsEditing.BatchEditSettings.StartEditAction = GridViewBatchStartEditAction.Click;
    settings.SettingsEditing.NewItemRowPosition = GridViewNewItemRowPosition.Bottom;

    settings.CommandColumn.Visible = true;
    settings.CommandColumn.ShowNewButtonInHeader = true;
    settings.CommandColumn.ShowDeleteButton = true;
    settings.CommandColumn.ShowEditButton = true;

    settings.CommandColumn.Width = 100;
    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;

    settings.Settings.ShowFilterRow = false;
    settings.Settings.ShowFilterRowMenu = false;

    settings.Columns.Add(column =>
    {
        column.FieldName = "Id";
        column.Caption = "Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        // Kunci baris Tx_ProductionTask_Item.
        column.FieldName = "DetId";
        column.Caption = "Det Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "LineNum";
        column.Caption = "LineNum";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Direction";
        column.Name = "Direction";
        column.Caption = "Direction";
        column.ColumnType = MVCxGridViewColumnType.ComboBox;

        var cbo = column.PropertiesEdit as ComboBoxProperties;
        cbo.DataSource = Models._Utils.GeneralGetList.GetList("Direction");
        cbo.ClientInstanceName = settings.Name + "_" + column.FieldName;

        cbo.TextField = "Name";
        cbo.ValueField = "Code";
        cbo.ValueType = typeof(string);
        cbo.ValidationSettings.RequiredField.IsRequired = true;

        column.Width = 90;
        column.ReadOnly = false;
        column.Settings.AllowSort = DefaultBoolean.False;

    });

    // 1. Kolom ASLI - biasa saja, TIDAK di-template, ikut mekanisme normal (seperti Id/DetId)
    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemCode";
        column.Name = "ItemCode";
        column.Caption = "Item Code";
        column.Width = 0;              // sembunyikan secara visual
        column.ReadOnly = true;

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.CellStyle.Wrap = DefaultBoolean.False;
        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_ItemCodeReal";   // beri nama beda biar jelas
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    // 2. Kolom DISPLAY - dummy, ini yang tampil ke user dengan tombol CFL
    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemCode";     // tetap baca dari field yang sama untuk tampilan awal
        column.Name = "ItemCodeDisplay";   // Name beda dari FieldName, supaya tidak konflik
        column.Caption = "Item Code";
        column.Width = 150;
        column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.SetEditItemTemplateContent(c =>
        {
            var itemCode = DataBinder.Eval(c.DataItem, "ItemCode");

            Html.DevExpress().ButtonEdit(s =>
            {
                s.Name = settings.Name + "_ItemCode";                     // <-- nama tetap "ItemCode" (dipakai JS)
                s.Properties.ClientInstanceName = settings.Name + "_ItemCode";

                s.Text = itemCode != null ? itemCode.ToString() : "";
                s.ReadOnly = true;
                s.Width = 125;

                s.Properties.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#E0E0E0");
                s.ControlStyle.CssClass = "editor";

                s.Properties.Buttons.Clear();
                EditButton lookUpButton = new EditButton();
                lookUpButton.Text = "";
                lookUpButton.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                lookUpButton.Image.Width = 15;
                s.Properties.Buttons.Add(lookUpButton);

                s.Properties.ClientSideEvents.ButtonClick = "BtnCflItemCodePopupListOnClick";
            }).Render();
        });
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemName";
        column.Name = "ItemName";
        column.Caption = "Item Name";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 250;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        column.CellStyle.Wrap = DefaultBoolean.False;
        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "WhsCode";
        column.Name = "WhsCode";
        column.Caption = "Whs Code";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 92;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;

        //column.ColumnType = MVCxGridViewColumnType.ComboBox;
        //var cbo = column.PropertiesEdit as ComboBoxProperties;
        //cbo.DataSource = Models._Utils.GeneralGetList.GetWarehouses();
        //cbo.ClientSideEvents.ValueChanged =
        //    "function(s, e) { " +
        //        "var item = s.GetSelectedItem(); " +
        //        "var name = item ? item.GetColumnText('WhsName') : null;" +
        //        "gvDetail_WhsCodeOnChange(s, e, name);" +
        //    "}";

        //cbo.TextField = "WhsCode";
        //cbo.ValueField = "WhsName";
        //cbo.ValueType = typeof(string);

        //cbo.Columns.Add("WhsCode", "Whs Code", 80);
        //cbo.Columns.Add("WhsName", "Whs Name", 200);
        //cbo.Width = 92;
        //cbo.TextFormatString = "{0}";
        //cbo.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
        //cbo.ValidationSettings.RequiredField.IsRequired = true;
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "WhsName";
        column.Name = "WhsName";
        column.Caption = "Whs Name";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 200;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "UomEntry";
        column.Name = "UomEntry";
        column.Caption = "UomEntry";
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 0;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Uom";
        column.Name = "Uom";
        column.Caption = "Uom";
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });


    settings.Columns.Add(column =>
    {
        column.FieldName = "QuantityPlanned";
        column.Name = "QuantityPlanned";
        column.Caption = "Quantity Planned";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.SpinEdit;
        column.HeaderStyle.HorizontalAlign = HorizontalAlign.Right;
        column.Width = 120;
        column.ReadOnly = true;
        var txt = column.PropertiesEdit as SpinEditProperties;
        txt.AllowMouseWheel = false;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");

        txt.DisplayFormatString = "#,###";
        txt.SpinButtons.ShowIncrementButtons = false;
    });

    settings.Columns.Add(column =>
    {
        // Total kumulatif lintas SEMUA activity -- selalu read-only, tidak pernah diedit di sini.
        column.FieldName = "QuantityActual";
        column.Name = "QuantityActual";
        column.Caption = "Quantity Actual";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.SpinEdit;
        column.Width = 120;
        column.ReadOnly = true;

        var txt = column.PropertiesEdit as SpinEditProperties;
        txt.NumberType = SpinEditNumberType.Float;
        txt.DisplayFormatString = "#,###";
        txt.DisplayFormatInEditMode = true;
        txt.SpinButtons.ShowIncrementButtons = false;
        txt.AllowMouseWheel = false;
        txt.Style.HorizontalAlign = HorizontalAlign.Right;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });

    settings.Columns.Add(column =>
    {
        // Kontribusi activity yang sedang di-Finish saja (bukan kumulatif).
        // Out: read-only, otomatis = SUM Netto batch popup untuk item + activity ini.
        // In: diketik manual user; nilainya dikirim ke server saat submit Finish (bukan lewat
        // AJAX row-update grid ini), dibaca lewat GetItemActivityQuantities() di ProductionTaskActivity.cshtml.
        column.FieldName = "QuantityActivity_";
        column.Name = "QuantityActivity_";
        column.Caption = "Netto";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.SpinEdit;
        column.Width = 120;

        column.SetDataItemTemplateContent(c =>
        {
            var itemDetId = DataBinder.Eval(c.DataItem, "DetId");
            var quantity = DataBinder.Eval(c.DataItem, "QuantityActivity_");
            var direction = DataBinder.Eval(c.DataItem, "Direction");

            bool isOut = direction != null && direction.ToString() == "Out";

            if (isOut)
            {
                // Direction = Out -> pakai ButtonEdit (CFL popup), readonly, pilih via popup
                Html.DevExpress().SpinEdit(s =>
                {
                    s.Name = settings.Name + "_" + column.FieldName + "_" + itemDetId;
                    s.Properties.ClientInstanceName = settings.Name + "_" + column.FieldName + "_" + itemDetId;

                    s.Number = quantity != null ? Convert.ToDecimal(quantity) : 0;

                    s.Properties.NumberType = SpinEditNumberType.Float;
                    s.Properties.DisplayFormatString = "#,###";
                    s.Properties.DisplayFormatInEditMode = true;
                    s.Properties.SpinButtons.ShowIncrementButtons = false;
                    s.Properties.Style.HorizontalAlign = HorizontalAlign.Right;

                    s.ReadOnly = true;
                    s.Width = 100;

                    s.Properties.Buttons.Clear();

                    EditButton btn = new EditButton();
                    btn.Text = "";
                    btn.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                    btn.Image.Width = 15;

                    s.Properties.Buttons.Add(btn);

                    s.Properties.ClientSideEvents.ButtonClick = string.Format("function(s, e) {{ BtnCflQuantityPopupListOnClick(s, e, '{0}'); }}", itemDetId);

                }).Render();

            }
            else
            {
                // Direction = In -> editable langsung; TIDAK memicu AJAX row-update.
                Html.DevExpress().SpinEdit(s =>
                {
                    s.Name = settings.Name + "_" + column.FieldName + "_" + itemDetId;
                    s.Properties.ClientInstanceName = settings.Name + "_" + column.FieldName + "_" + itemDetId;

                    s.Number = quantity != null ? Convert.ToDecimal(quantity) : 0;
                    s.Properties.DecimalPlaces = 0;
                    s.Properties.DisplayFormatString = "N0";
                    s.Properties.DisplayFormatInEditMode = true;
                    s.Properties.SpinButtons.ShowIncrementButtons = false;
                    s.ControlStyle.HorizontalAlign = HorizontalAlign.Right;
                    s.Properties.AllowMouseWheel = false;
                    s.ReadOnly = false;
                    s.Width = 100;

                }).Render();

            }
        });

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Comments";
        column.Name = "Comments";
        column.Caption = "Free Text";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 200;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

    });

    settings.ClientSideEvents.BeginCallback = string.Format("function(s, e) {{ gvContentItemListOnBeginCallback(s, e, {0}, {1}); }}", Id, ActivityDetId);
    settings.ClientSideEvents.EndCallback = string.Format("function(s, e) {{ gvContentItemListOnEndCallback(s, e, {0}, {1}); }}", Id, ActivityDetId);
    settings.ClientSideEvents.BatchEditRowInserting = string.Format("function(s, e) {{ gvContentItemListOnRowInserting(s, e, {0}, {1}); }}", Id, ActivityDetId);
    settings.ClientSideEvents.BatchEditStartEditing =
    "function(s, e) { " +
        "if (e.focusedColumn.fieldName == 'QuantityActivity_') { " +
            "var direction = s.batchEditApi.GetCellValue(e.visibleIndex, 'Direction'); " +
            "if (direction == 'Out') { " +
                "e.cancel = true; " +
            "} " +
        "} " +
    "}";

    settings.InitNewRow = (s, e) =>
    {
        // "DetId" identity -> diisi database, jangan di-set dari sini.
        e.NewValues["Id"] = Id;
        e.NewValues["Direction"] = "In";
        e.NewValues["LineNum"] = -1;
    };

    settings.HtmlDataCellPrepared = (sender, e) =>
    {
        if (e.DataColumn.FieldName == "QuantityActivity_")
        {
            var direction = e.GetValue("Direction");
            if (direction != null && direction.ToString() == "Out")
            {
                e.Cell.BackColor = System.Drawing.Color.FromName("#EDEDED");
            }
        }
    };

}).Bind(Model).GetHtml()

@* DetId item Direction=In pada halaman ini -> dibaca GetItemActivityQuantities() di
   ProductionTaskActivity.cshtml untuk mengumpulkan input QuantityActivity_ manual user
   saat submit Finish (nilai TIDAK di-AJAX-simpan lewat grid, baru dipakai saat Finish). *@
<script type="text/javascript">
    window.productionActivityInItemDetIds = [@Html.Raw(string.Join(",", (Model ?? new List<Models.Production.ProductionTaskDetailItemModel>())
        .Where(x => string.Equals(x.Direction, "In", StringComparison.OrdinalIgnoreCase))
        .Select(x => x.DetId ?? 0)))];
</script>
