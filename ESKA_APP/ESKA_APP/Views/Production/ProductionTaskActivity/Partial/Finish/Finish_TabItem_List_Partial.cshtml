@using System.Collections.Generic;
@using Models;
@model List<Models.Production.ProductionTaskDetailItemModel>

@{
    var Id = Convert.ToInt64(Request["cbId"]);
    var DetId = Convert.ToInt64(Request["cbDetId"]);
    int userId = (int)Session["userId"];

    if (ViewBag.Id != null){ Id = ViewBag.Id; }
    if (ViewBag.DetId != null) { DetId = ViewBag.DetId; }
}

@Html.DevExpress().GridView(settings =>
{

    settings.Name = "gvContentItemList";
    settings.KeyFieldName = "DetDetId";
    settings.Width = Unit.Percentage(100);
    settings.CallbackRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListPartial", Id = Id, DetId = DetId };
    settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListAddNewRow", Id = Id, DetId = DetId };
    settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListUpdateRow", Id = Id, DetId = DetId };
    settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "ProductionTaskActivity", Action = "TabItemListDeleteRow", Id = Id, DetId = DetId };

    settings.SettingsBehavior.ConfirmDelete = true;
    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;
    settings.Settings.VerticalScrollableHeight = 200;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;

    settings.SettingsEditing.Mode = GridViewEditingMode.Inline;
    settings.SettingsEditing.BatchEditSettings.EditMode = GridViewBatchEditMode.Row;
    settings.SettingsEditing.BatchEditSettings.StartEditAction = GridViewBatchStartEditAction.Click;
    settings.SettingsEditing.NewItemRowPosition = GridViewNewItemRowPosition.Bottom;

    settings.CommandColumn.Visible = true;
    settings.CommandColumn.ShowNewButtonInHeader = true;
    settings.CommandColumn.ShowDeleteButton = true;
    settings.CommandColumn.ShowEditButton = true;

    settings.CommandColumn.Width = 100;
    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;

    settings.Settings.ShowFilterRow = false;
    settings.Settings.ShowFilterRowMenu = false;

    settings.Columns.Add(column =>
    {
        column.FieldName = "Id";
        column.Caption = "Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "DetId";
        column.Caption = "Det Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "DetDetId";
        column.Caption = "Det Id";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "LineNum";
        column.Caption = "LineNum";
        column.Width = 0;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#E0E0E0");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Direction";
        column.Name = "Direction";
        column.Caption = "Direction";
        column.ColumnType = MVCxGridViewColumnType.ComboBox;

        var cbo = column.PropertiesEdit as ComboBoxProperties;
        cbo.DataSource = Models._Utils.GeneralGetList.GetList("Direction");
        cbo.ClientInstanceName = settings.Name + "_" + column.FieldName;

        cbo.TextField = "Name";
        cbo.ValueField = "Code";
        cbo.ValueType = typeof(string); 

        column.Width = 90;
        column.ReadOnly = false;
        column.Settings.AllowSort = DefaultBoolean.False;

    });
    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemCode";
        column.Name = "ItemCode";
        column.Caption = "Item Code";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 150;
        column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.SetEditItemTemplateContent(c =>
        {
            var itemCode = DataBinder.Eval(c.DataItem, "ItemCode");

            Html.DevExpress().ButtonEdit(s =>
            {
                s.Name = settings.Name + "_" + column.FieldName;
                s.Properties.ClientInstanceName = settings.Name + "_" + column.FieldName;

                s.Text = itemCode != null ? itemCode.ToString() : "";   // <-- ButtonEditSettings.Text sudah terbukti valid

                s.ReadOnly = true;
                s.Width = 125;

                s.Properties.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#E0E0E0");
                s.ControlStyle.CssClass = "editor";

                s.Properties.Buttons.Clear();

                EditButton lookUpButton = new EditButton();
                lookUpButton.Text = "";
                lookUpButton.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                lookUpButton.Image.Width = 15;
                s.Properties.Buttons.Add(lookUpButton);

                s.Properties.ClientSideEvents.ButtonClick = "BtnCflItemCodePopupListOnClick";

            }).Render();
        });

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemName";
        column.Name = "ItemName";
        column.Caption = "Item Name";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 250;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "WhsCode";
        column.Name = "WhsCode";
        column.Caption = "Whs Code";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 92;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;

        //column.ColumnType = MVCxGridViewColumnType.ComboBox;
        //var cbo = column.PropertiesEdit as ComboBoxProperties;
        //cbo.DataSource = Models._Utils.GeneralGetList.GetWarehouses();
        //cbo.ClientSideEvents.ValueChanged =
        //    "function(s, e) { " +
        //        "var item = s.GetSelectedItem(); " +
        //        "var name = item ? item.GetColumnText('WhsName') : null;" +
        //        "gvDetail_WhsCodeOnChange(s, e, name);" +
        //    "}";

        //cbo.TextField = "WhsCode";
        //cbo.ValueField = "WhsName";
        //cbo.ValueType = typeof(string);

        //cbo.Columns.Add("WhsCode", "Whs Code", 80);
        //cbo.Columns.Add("WhsName", "Whs Name", 200);
        //cbo.Width = 92;
        //cbo.TextFormatString = "{0}";
        //cbo.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
        //cbo.ValidationSettings.RequiredField.IsRequired = true;
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "WhsName";
        column.Name = "WhsName";
        column.Caption = "Whs Name";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 200;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "UomEntry";
        column.Name = "UomEntry";
        column.Caption = "UomEntry";
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 0;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Uom";
        column.Name = "Uom";
        column.Caption = "Uom";
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });


    settings.Columns.Add(column =>
    {
        column.FieldName = "QuantityPlanned";
        column.Name = "QuantityPlanned";
        column.Caption = "Quantity Planned";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.SpinEdit;
        column.HeaderStyle.HorizontalAlign = HorizontalAlign.Right;
        column.Width = 120;
        column.ReadOnly = true;

        var txt = column.PropertiesEdit as SpinEditProperties;
        txt.AllowMouseWheel = false;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");

        txt.DisplayFormatString = "#,###";
        txt.SpinButtons.ShowIncrementButtons = false;
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "QuantityActual";
        column.Name = "QuantityActual";
        column.Caption = "Netto";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ClientInstanceName = settings.Name + "_" + column.FieldName;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.SetDataItemTemplateContent(c =>
        {
            var visibleIndex = c.VisibleIndex;
            var detDetId = DataBinder.Eval(c.DataItem, "DetDetId");
            var quantity = DataBinder.Eval(c.DataItem, "QuantityActual");
            var direction = DataBinder.Eval(c.DataItem, "Direction");

            bool isOut = direction != null && direction.ToString() == "Out";

            if (isOut)
            {
                // Direction = Out -> pakai ButtonEdit (CFL popup), readonly, pilih via popup
                Html.DevExpress().ButtonEdit(s =>
                {
                    s.Name = settings.Name + "_" + column.FieldName + "_" + visibleIndex;
                    s.Properties.ClientInstanceName = settings.Name + "_" + column.FieldName + "_" + visibleIndex;

                    s.Text = quantity != null ? Convert.ToDecimal(quantity).ToString("N0") : "";

                    s.ReadOnly = true;
                    s.Width = 100;

                    s.Properties.Buttons.Clear();

                    EditButton btn = new EditButton();
                    btn.Text = "";
                    btn.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                    btn.Image.Width = 15;

                    s.Properties.Buttons.Add(btn);

                    s.Properties.ClientSideEvents.ButtonClick = string.Format("function(s, e) {{ BtnCflQuantityPopupListOnClick(s, e, '{0}'); }}", detDetId);

                }).Render();
            }
            else
            {
                // Direction = In -> input manual biasa (TextBox editable)
                Html.DevExpress().TextBox(s =>
                {
                    s.Name = settings.Name + "_" + column.FieldName + "_" + visibleIndex;
                    s.Properties.ClientInstanceName = settings.Name + "_" + column.FieldName + "_" + visibleIndex;

                    s.Text = quantity != null ? Convert.ToDecimal(quantity).ToString("N0") : "";

                    s.ReadOnly = false;
                    s.Width = 100;

                }).Render();
            }
        });

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Comments";
        column.Name = "Comments";
        column.Caption = "Free Text";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 200;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

    });

    settings.ClientSideEvents.BeginCallback = string.Format("function(s, e) {{ gvContentItemListOnBeginCallback(s, e, {0}, {1}); }}", Id, DetId);
    settings.ClientSideEvents.EndCallback = string.Format("function(s, e) {{ gvContentItemListOnEndCallback(s, e, {0}, {1}); }}", Id, DetId);
    settings.ClientSideEvents.BatchEditRowInserting = string.Format("function(s, e) {{ gvContentItemListOnRowInserting(s, e, {0}, {1}); }}", Id, DetId);
    settings.ClientSideEvents.BatchEditStartEditing =
    "function(s, e) { " +
        "if (e.focusedColumn.fieldName == 'QuantityActual') { " +
            "var direction = s.batchEditApi.GetCellValue(e.visibleIndex, 'Direction'); " +
            "if (direction == 'Out') { " +
                "e.cancel = true; " +
            "} " +
        "} " +
    "}";

    settings.InitNewRow = (s, e) =>
    {
        e.NewValues["Id"] = Id;
        e.NewValues["DetId"] = DetId;
        e.NewValues["Direction"] = "In";

        e.NewValues["AdmissionDate"] = DateTime.Today;
    };

    settings.HtmlDataCellPrepared = (sender, e) =>
    {
        if (e.DataColumn.FieldName == "QuantityActual")
        {
            var direction = e.GetValue("Direction");
            if (direction != null && direction.ToString() == "Out")
            {
                e.Cell.BackColor = System.Drawing.Color.FromName("#EDEDED");
            }
        }
    };
}).Bind(Model).GetHtml()
