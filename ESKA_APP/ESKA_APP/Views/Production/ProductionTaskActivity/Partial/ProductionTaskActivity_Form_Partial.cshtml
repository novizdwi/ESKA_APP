@using Models.Transaction;
@using System.Web.Script.Serialization;
@using System.Web.UI.WebControls;
@using System.Drawing
@using System.Drawing.Imaging
@using System.IO

@model Models.Production.ProductionTaskActivityModel

@{

    ViewBag.Id = Model.Id ?? 0;

    // ---- DURASI : jam saat ini dikurang ActivityDate ----
    string durasi = "-";
    if (Model.ActivityDate.HasValue)
    {
        TimeSpan ts = DateTime.Now - Model.ActivityDate.Value;
        if (ts.TotalSeconds < 0)
        {
            ts = TimeSpan.Zero;
        }
        durasi = string.Format("{0:00}:{1:00}", (int)ts.TotalHours, ts.Minutes);
    }

    // ---- PAUSE DURATION ----
    string pauseDuration = "00:00";
    if (Model.PauseHours.HasValue)
    {
        TimeSpan pauseTs = TimeSpan.FromSeconds((double)Model.PauseHours.Value);
        pauseDuration = string.Format("{0:00}:{1:00}", (int)pauseTs.TotalHours, pauseTs.Minutes);
    }

    string dueDate = Model.DueDate.HasValue
        ? Model.DueDate.Value.ToString("dd/MM/yyyy HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)
        : "-";

    // START TIME dipecah tanggal/jam jadi 2 kolom terpisah, supaya kolom jamnya sejajar
    // dengan PAUSE DURATION dan DURATION (sama-sama format jam).
    string startDateOnly = Model.ActivityDate.HasValue
        ? Model.ActivityDate.Value.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)
        : "-";
    string startTimeOnly = Model.ActivityDate.HasValue
        ? Model.ActivityDate.Value.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)
        : "";

    string activityIso = Model.ActivityDate.HasValue
        ? Model.ActivityDate.Value.ToString("yyyy/MM/dd HH:mm:ss")
        : "";

    // ---- Status: tentukan tombol Pause / Start ----
    bool isPaused = string.Equals(Model.ActivityStatus, "Paused", StringComparison.OrdinalIgnoreCase);
    string pauseText = isPaused ? "Start" : "Pause";
    string pauseClientHandler = isPaused ? "OnClickBtnStart" : "OnClickBtnPause";
    // Pause hanya enabled saat OnProgres; saat Paused tombolnya jadi Start (tetap enabled).
}

@* Style dipindah ke Content/Styles.css, di-scope lewat #formLayoutActivity karena
   nama "formLayout" dipakai ulang di banyak form lain (~28 view). *@

<br />

@Html.DevExpress().TextBox(
        settings =>
        {
            settings.Name = "Id";
            settings.ControlStyle.CssClass = "editor";
            settings.ShowModelErrors = true;
            settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
            settings.ClientVisible = false;
        }
).Bind(Model.Id).GetHtml()

@Html.DevExpress().TextBox(
        settings =>
        {
            settings.Name = "DetId";
            settings.ControlStyle.CssClass = "editor";
            settings.ShowModelErrors = true;
            settings.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithTooltip;
            settings.ClientVisible = false;
        }
).Bind(Model.DetId).GetHtml()

@Html.DevExpress().FormLayout(settings =>
{
    settings.Name = "formLayoutActivity";
    settings.EncodeHtml = false;
    settings.Width = Unit.Percentage(100);
    settings.AlignItemCaptionsInAllGroups = true;
    settings.ShowItemCaptionColon = true;
    settings.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.SingleColumnWindowLimit;
    settings.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 600;

    // ===================== HEADER : TASK NO =====================
    var groupHeader = settings.Items.AddGroupItem(g =>
    {
        g.Caption = "";
        g.GroupBoxDecoration = GroupBoxDecoration.None;
        g.ShowCaption = DefaultBoolean.False;
        g.ColCount = 1;
        g.Width = Unit.Percentage(100);
    });

    groupHeader.Items.Add(x =>
    {
        x.ShowCaption = DefaultBoolean.False;
        x.HorizontalAlign = FormLayoutHorizontalAlign.Left;
    }).SetNestedContent(() =>
    {
        string pausedBadge = isPaused
            ? " <span style='color:#E7180B;'>PAUSED</span>"
            : "";

        ViewContext.Writer.Write(
            "<span style='margin:0; font-size:250%; font-weight:bolder;'>" +
            "<b>TASK NO: [ " + Model.TransNo + " ]</b>" +
            pausedBadge +
            "</span>"
        );
    });

    // spacer
    groupHeader.Items.AddEmptyItem().Height = 12;

    // ===================== INFO ACTIVITY : semua sebagai satu table =====================
    // Dirender manual (bukan caption/content item FormLayout satu-satu) supaya label
    // dan isi pasti sejajar, tidak bergantung ke layout adaptif DevExpress.
    groupHeader.Items.Add(x =>
    {
        x.ShowCaption = DefaultBoolean.False;
    }).SetNestedContent(() =>
    {
        ViewContext.Writer.Write(new HtmlString(@"
            <table class='activityInfoTable'>
                <colgroup>
                    <col style='width:230px' />
                    <col style='width:140px' />
                    <col />
                </colgroup>
                <tr>
                    <td class='cap'>Work Order No</td>
                    <td colspan='2'>" + Html.Encode(Model.DocNum) + @" - " + Html.Encode(Model.RoutingName) + @"</td>
                </tr>
                <tr>
                    <td class='cap'>Item</td>
                    <td colspan='2'>" + Html.Encode(Model.ItemName) + @"</td>
                </tr>
                <tr>
                    <td class='cap'>Due Date</td>
                    <td colspan='2'>" + dueDate + @"</td>
                </tr>
                <tr class='spacer'><td colspan='3'></td></tr>
                <tr>
                    <td class='cap'>TARGET</td>
                    <td colspan='2'><b>" + (Model.QuantityPlanned.HasValue ? Model.QuantityPlanned.Value.ToString("0.####") : "0") + @"</b></td>
                </tr>
                <tr>
                    <td class='cap'>FINISHED</td>
                    <td colspan='2'><b>" + (Model.QuantityComplete.HasValue ? Model.QuantityComplete.Value.ToString("0.####") : "0") + @"</b></td>
                </tr>
                <tr>
                    <td class='cap'>REMAINING</td>
                    <td colspan='2'><b>" + (Model.QuantityRemain.HasValue ? Model.QuantityRemain.Value.ToString("0.####") : "0") + @"</b></td>
                </tr>
                <tr class='spacer'><td colspan='3'></td></tr>
                <tr>
                    <td class='cap'>START TIME</td>
                    <td class='val-date'>" + startDateOnly + @"</td>
                    <td class='val-time'><b>" + startTimeOnly + @"</b></td>
                </tr>
                <tr>
                    <td class='cap'>PAUSE DURATION</td>
                    <td class='val-date'></td>
                    <td class='val-time'><b>" + pauseDuration + @"</b></td>
                </tr>
                <tr>
                    <td class='cap'>DURATION</td>
                    <td class='val-date'></td>
                    <td class='val-time'><b id='lblDurasi' data-start='" + activityIso + @"'>" + durasi + @"</b></td>
                </tr>
            </table>
        "));
    });

}).GetHtml()

@* ======= TOMBOL : PAUSE/START & FINISH =======
   Dirender manual (bukan lewat FormLayout ColCount=2) supaya kedua tombol dijamin
   sama besar (flexbox), bukan tebak-tebakan lebar kolom DevExpress. Sticky di bawah
   layar (position:fixed, lihat .activityStickyButtons di Styles.css) -- dipakai tablet.
   btnPause/btnFinish di sini bukan ASPxClientButton, tapi OnClickBtnPause/OnClickBtnStart/
   OnClickBtnFinish di ProductionTaskActivity.cshtml tidak memakai parameter s/e-nya,
   jadi aman dipanggil langsung dari onclick biasa. *@
@{
    bool pauseBtnEnabled = ViewBag.Id != 0;
    bool finishBtnEnabled = ViewBag.Id != 0 && Model.ActivityStatus != "Paused";
    string pauseBg = isPaused ? "#2D9966" : "#CD5C5C";
}
<div class="activityStickyButtons">
    <button type="button" id="btnPause" class="activityBtn" style="background-color:@pauseBg;" onclick="@(pauseClientHandler)(this, event)" @(pauseBtnEnabled ? "" : "disabled")>@pauseText</button>
    <button type="button" id="btnFinish" class="activityBtn" style="background-color:#0b64c5;" onclick="OnClickBtnFinish(this, event)" @(finishBtnEnabled ? "" : "disabled")>Finish</button>
</div>

@* ======= DURATION: running clock, jalan sendiri tanpa perlu refresh ======= *@
<script type="text/javascript">
    (function () {
        // Partial ini di-render ulang tiap Pause/Start/Finish/Refresh lewat
        // $("#contentForm").html(response), jadi interval lama wajib dibersihkan
        // dulu supaya tidak menumpuk jadi banyak timer berjalan bersamaan.
        if (window.eskaDurasiTimerId) {
            clearInterval(window.eskaDurasiTimerId);
            window.eskaDurasiTimerId = null;
        }

        var el = document.getElementById('lblDurasi');
        if (!el) return;

        var startStr = el.getAttribute('data-start');
        if (!startStr) return;

        var startDate = new Date(startStr);
        if (isNaN(startDate.getTime())) return;

        function tick() {
            var diffMs = new Date().getTime() - startDate.getTime();
            if (diffMs < 0) diffMs = 0;

            var totalMinutes = Math.floor(diffMs / 60000);
            var hours = Math.floor(totalMinutes / 60);
            var minutes = totalMinutes % 60;

            el.textContent = (hours < 10 ? '0' : '') + hours + ':' + (minutes < 10 ? '0' : '') + minutes;
        }

        tick();
        window.eskaDurasiTimerId = setInterval(tick, 1000);
    })();
</script>
