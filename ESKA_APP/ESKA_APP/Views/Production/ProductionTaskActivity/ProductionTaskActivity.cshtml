    popup pause
    -----------------------------------------------------------------------------
*@
<script type="text/javascript">

    function popupPause_EndCallback(s, e) {
        $.validator.unobtrusive.parse("#Pause_formDetail");

        var popup = ASPxClientPopupControl.Cast("popupPause");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(400, 100);
        }
    }

    function btnShowPauseOnClick(s, e, id, detId) {
        var popup = ASPxClientPopupControl.Cast("popupPause");
        popup.callbackUrl = '@Url.Action("Pause_PopupListOnDemandPartial", "ProductionTaskActivity")' + '?Id=' + id + '&DetId=' + detId;
        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }

    function btnUpdatePauseOnClick(s, e) {
        var data = GetFormPauseData();

        // Quantity wajib
        if (data.PauseReason == null || data.PauseReason === "") {
            PauseReason.Focus();
            return;
        }
        $.ajax({
            type: "POST",
            url: '@Url.Action("PauseActivity", "ProductionTaskActivity")',
            data: data,
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                popupPause.Hide();
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown);
            },
            complete: function () { OnComplete(); }
        });
    }

    function btnCancelPauseOnClick(s, e) {
        var popup = ASPxClientPopupControl.Cast("popupPause");
        popup.Hide();
    }

    function GetFormPauseData() {
        return {
            Id: Id.GetValue(),
            DetId: DetId.GetValue(),
            PauseReason: PauseReason.GetValue(),
            PauseComments: PauseComments.GetValue()
        };
    }

</script>

