@model Models.Production.ProductionTaskActivityModel

@{
    ViewBag.UserId = (int)Session["userId"];
    ViewBag.Title = "Process Card";

}

<script type="text/javascript">


    $(document).ready(function () {

        SetBtnStatus();
    }
    );


</script>



<script type="text/javascript">

    var beforeSaveActiveTabName = '';
    var beforeSaveActiveTabIndex = 0;

    $.ajaxSetup({
        cache: false
    });

    function OnBegin() {
        loadingPanel.Show();

    }

    function SetBtnStatus() {

    }

    var msgCount = 0;
    function OnSuccess() {
        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());

    }


    function OnSuccessMsgBox() {

        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());
        loadingPanel.Hide();

        popupSuccess.Show();
        setTimeout(function () { popupSuccess.Hide(); }, 1000);

    }

    function OnFailure(jqXhr, textStatus, errorThrown) {
        if (beforeSaveActiveTabName != '') {
            var tab = ASPxClientTabControl.Cast(beforeSaveActiveTabName);
            tab.SetActiveTabIndex(beforeSaveActiveTabIndex);
            beforeSaveActiveTabName = '';
        }

        if (jqXhr.responseText.substring(0, 12) == "[VALIDATION]") {
            $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + jqXhr.responseText + '</p>' + $("#MessageText").html());

            loadingPanel.Hide()
            alert(jqXhr.responseText);
        }
        else {
            // untuk error yg tidak ter capture di validation
            var doc = jqXhr.responseText.match(/.*<title>([\s\S]*)<\/title>.*/);
            if (doc != null) {
                $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + doc[1] + '</p>' + $("#MessageText").html());

                loadingPanel.Hide();
                alert(doc[1]);
            }

        }

    }

    function OnComplete() {
        loadingPanel.Hide();
    }


    function BeforeSave() {

        var tab = ASPxClientTabControl.Cast("TabDetail");
        var tabPageCount = tab.GetTabCount();
        for (var i = 0; i < tabPageCount; i++) {
            tab.SetActiveTabIndex(i);
            if (!($("#formDetail").valid())) {
                var validator = $("#formDetail").validate();
                var errors = validator.numberOfInvalids();
                if (errors) {
                    // alert( validator.errorList[0].message);
                    validator.errorList[0].element.focus();

                }
                return false;
            }
        }

        return true;

    }


    function RefreshAfterSuccess(response) {
        $("#contentForm").html(response);

        $.validator.unobtrusive.parse("#formDetail");

        MVCxClientUtils.FinalizeCallback();
        SetBtnStatus();
    }

    function OnClickBtnNew(s, e) {

        $.ajax({
            type: "POST",
            url: "@Url.Action("DetailPartial", "ProductionTaskActivity")",
            beforeSend: function () {
                OnBegin();
            },

            success: function (response) {
                RefreshAfterSuccess(response);
                OnSuccess();
            },

            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },

            complete: function () {
                OnComplete()
            }
        });

    }

    function OnClickBtnPost(s, e) {

        if (BeforeSave() == false) {
            return;
        }
        key = Id.GetValue();

        var isApproval = ApprovalTemplateId_.GetValue();
        var approvalStatus = ApprovalStatus.GetValue();

        if ((isApproval != "-1" || approvalStatus != null) && approvalStatus != "Approved") {
            btnShowApprovalOnClick(s, e, key);
        } else {
            Post(s, e);
        }
    }

    function Post(s, e) {
         var formData = GetFormData();
        if (confirm('Post transaction?')) {
            key = Id.GetValue();

            $.ajax({
                type: "POST",
                url: '@Url.Action("Post", "ProductionTaskActivity")',
                data: formData,
                beforeSend: function () {
                    OnBegin();
                },
                success: function (response) {
                    RefreshAfterSuccess(response);
                    OnSuccessMsgBox();

                },
                error: function (jqXhr, textStatus, errorThrown) {
                    OnFailure(jqXhr, textStatus, errorThrown)
                },
                complete: function () {
                    OnComplete()
                }
            });
        }
    }

    function btnApproveApprovalOnClick(s, e) {
        key = Id.GetValue();
        var reason = RequestMassage.GetValue();

        $.ajax({
            type: "POST",
            url: '@Url.Action("Approve", "ProductionTaskActivity")',
            data: { Id: key, ApprovalMessage: reason },
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                popupApproval.Hide();
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete()

            }
        });

    }

    function btnRequestApprovalOnClick(s, e) {
        key = Id.GetValue();
        var reason = RequestMassage.GetValue();
        var templateId = ApprovalTemplateId_.GetValue();

        $.ajax({
            type: "POST",
            url: '@Url.Action("RequestApproval", "ProductionTaskActivity")',
            data: { id: key, templateId: templateId, approvalMessage: reason },
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                popupApproval.Hide();
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete()

            }
        });
    }

    function btnRejectApprovalOnClick(s, e) {
        if (confirm('Are you sure to Reject this transaction?')) {
             key = Id.GetValue();
            var reason = RequestMassage.GetValue();

            $.ajax({
                type: "POST",
                url: '@Url.Action("Reject", "ProductionTaskActivity")',
                data: { Id: key, ApprovalMessage: reason },
                beforeSend: function () {
                    OnBegin();
                },
                success: function (response) {
                    popupApproval.Hide();
                    RefreshAfterSuccess(response);
                    OnSuccessMsgBox();
                },
                error: function (jqXhr, textStatus, errorThrown) {
                    OnFailure(jqXhr, textStatus, errorThrown)
                },
                complete: function () {
                    OnComplete()

                }
            });
        }

    }

 function popupApproval_EndCallback(s, e) {
        $.validator.unobtrusive.parse("#Approval_formDetail");

        var popup = ASPxClientPopupControl.Cast("popupApproval");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(400, 100);
        }
    }

    function btnShowApprovalOnClick(s, e, Id) {
        var popup = ASPxClientPopupControl.Cast("popupApproval");

        popup.callbackUrl = '@Url.Action("Approval_PopupListOnDemandPartial", "ProductionTaskActivity")' + '?Id=' + Id;
        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }

    function OnClickBtnCancel(s, e) {
        key = Id.GetValue();
        btnShowCancelReasonOnClick(s, e, key);
    }


    function GetFormData() {
        var formData = $('#formDetail').serializeObject();

        var Details_ = GetGvDetails('gvDetail');
        $.extend(formData, { Details_: Details_ });
        return formData;
    }


    function OnClickBtnAdd(s, e) {
        if (BeforeSave() == false) {
            return;
        }

        var formData = GetFormData();/*$('#formDetail').serializeObject();*/

        $.ajax({
            type: "POST",
            url: '@Url.Action("Add", "ProductionTaskActivity")',
            data: formData,
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete();
            }
        });


    }

    function OnClickBtnUpdate(s, e) {
        if (BeforeSave() == false) {
            return;
        }

        var formData = GetFormData();

        $.ajax({
            type: "POST",
            url: '@Url.Action("Update", "ProductionTaskActivity")',
            data: formData,
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();

            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete()

            }
        });



    }


    function OnClickBtnRefresh(s, e) {
        key = Id.GetValue();

        $.ajax({
            type: "POST",
            url: '@Url.Action("DetailPartial", "ProductionTaskActivity")',
            data: { Id: key },
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                RefreshAfterSuccess(response);
                OnSuccess();

            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete()
            }
        });
    }

    function OnClickBtnFinish(s, e) {
        var key = Id.GetValue();
        var keyDet = DetId.GetValue();
        btnShowFinishOnClick(s, e, key, keyDet);
    }

    function popupFinish_EndCallback(s, e) {
        $.validator.unobtrusive.parse("#Finish_formDetail");

        var popup = ASPxClientPopupControl.Cast("popupFinish");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(400, 100);
        }
    }


    // ====== PAUSE : status "OnProgres" -> "Paused" ======
    function OnClickBtnPause(s, e) {
        var key = Id.GetValue();
        var keyDet = DetId.GetValue();
        btnShowPauseOnClick(s, e, key, keyDet);
    }

    function popupFinish_EndCallback(s, e) {
        $.validator.unobtrusive.parse("#Pause_formDetail");

        var popup = ASPxClientPopupControl.Cast("popupPause");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(400, 100);
        }
    }



    // ====== START : status "Paused" -> "OnProgres" ======
    function OnClickBtnStart(s, e) {
        var data = GetFormStartData();

        $.ajax({
            type: "POST",
            url: '@Url.Action("StartActivity", "ProductionTaskActivity")',
            data: data,
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                RefreshAfterSuccess(response); // form re-render -> tombol jadi "Pause"
                OnSuccess();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown);
            },
            complete: function () {
                OnComplete();
            }
        });
    }

    function GetFormStartData() {
        return {
            Id: Id.GetValue(),
            DetId: DetId.GetValue(),
            PauseReason: null,
            PauseComments: null
        };
    }

    function BtnCflItemCodePopupListOnClick(s, e) {
        //cflWarehousePopupListSalesOrder.Show();

        var popup = ASPxClientPopupControl.Cast("cflItemByWarehousePopupListProductionTaskActivity");
        popup.callbackUrl = '@Url.Action("PopupListLoadOnDemandPartial", "_CflItemByWarehouse")';
        popup.PerformCallback();
        popup.Show();

    }

</script>

