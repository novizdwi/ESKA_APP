@*
    -----------------------------------------------------------------------------
    popup finish
    -----------------------------------------------------------------------------
*@
<script type="text/javascript">
    function gvContentItemListOnBeginCallback(s, e, Id, DetId) {

    }

    function gvContentItemListOnEndCallback(s, e, Id, DetId) { 
    }

    function gvContentItemListOnBatchEditStartEditing(s, e, Id, DetId) {
    }

    function gvContentItemListOnBatchEditEndEditing(s, e, Id, DetId) {

    }

    function gvContentItemListOnRowInserting(s, e, Id, DetId) {

    }

    function popupFinish_EndCallback(s, e) {
        //$.validator.unobtrusive.parse("#Finish_formDetail");

        var popup = ASPxClientPopupControl.Cast("popupFinish");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(400, 100);
        }
    }

    function btnShowFinishOnClick(s, e, id, detId) {
        var popup = ASPxClientPopupControl.Cast("popupFinish");
        popup.callbackUrl = '@Url.Action("Finish_PopupListOnDemandPartial", "ProductionTaskActivity")' + '?Id=' + id + '&DetId=' + detId;
        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }

    function btnUpdateFinishOnClick(s, e) {
        var data = GetFormFinishData();

        // Batch wajib (dicek juga di SpProductionTaskActivity__TransNotif)
        if (data.FinishBatch == null || data.FinishBatch === "") {
            var eBatch = ASPxClientTextBox.Cast("Batch");
            if (eBatch != null) { eBatch.Focus(); }
            return;
        }

        // Quantity wajib
        if (data.Quantity == null || data.Quantity === "") {
            var eQuantity = ASPxClientSpinEdit.Cast("Quantity");
            if (eQuantity != null) { eQuantity.Focus(); }
            return;
        }
        $.ajax({
            type: "POST",
            url: '@Url.Action("FinishActivity", "ProductionTaskActivity")',
            data: data,
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                popupFinish.Hide();
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown);
            },
            complete: function () { OnComplete(); }
        });
    }

    function btnCancelFinishOnClick(s, e) {
        var popup = ASPxClientPopupControl.Cast("popupFinish");
        popup.Hide();
    }

    function GetFormFinishData() {
        // Editor diambil lewat Cast(), bukan variabel global, supaya tetap menunjuk objek
        // yang benar sesudah popupFinish melakukan callback (LoadContentViaCallback).
        var eId = ASPxClientTextBox.Cast("Id");
        var eDetId = ASPxClientTextBox.Cast("DetId");
        var eBatch = ASPxClientTextBox.Cast("Batch");
        var eQuantity = ASPxClientSpinEdit.Cast("Quantity");
        var eComments = ASPxClientMemo.Cast("Comments");

        return {
            Id: eId != null ? eId.GetValue() : null,
            DetId: eDetId != null ? eDetId.GetValue() : null,

            // Editor bernama "Batch", tapi properti model nya "FinishBatch".
            FinishBatch: eBatch != null ? eBatch.GetValue() : null,

            Quantity: eQuantity != null ? eQuantity.GetValue() : null,
            Comments: eComments != null ? eComments.GetValue() : null,

            // Kontribusi QuantityActivity_ item Direction=In (diketik manual, belum persisted).
            itemQuantitiesJson: JSON.stringify(GetItemActivityQuantities())
        };
    }

    // Kumpulkan QuantityActivity_ tiap item Direction=In dari grid popup Finish.
    // Item Direction=Out TIDAK diikutkan -- nilainya dihitung server-side dari popup batch.
    function GetItemActivityQuantities() {
        var ids = window.productionActivityInItemDetIds || [];
        var result = [];

        for (var i = 0; i < ids.length; i++) {
            var detId = ids[i];
            var editor = ASPxClientSpinEdit.Cast('gvContentItemList_QuantityActivity__' + detId);
            if (editor == null) { continue; }

            result.push({
                DetId: detId,
                Direction: 'In',
                QuantityActivity_: editor.GetValue()
            });
        }

        return result;
    }

    function gvDetail_WhsCodeOnChange(s, e, name) {
        var WhsName = ASPxClientTextBox.Cast("gvContentItemList_WhsName");
        WhsName.SetValue(name);
    }

    // Tombol kaca pembesar pada kolom Netto grid item (hanya untuk Direction = 'Out').
    // itemDetId = kunci baris Tx_ProductionTask_Item, BUKAN kunci activity.
    function BtnCflQuantityPopupListOnClick(s, e, itemDetId) {
        var popup = ASPxClientPopupControl.Cast("popupBatch");

        var eId = ASPxClientTextBox.Cast("Id");
        // Editor "DetId" milik popupFinish sebenarnya adalah kunci Tx_ProductionTask_Activity.
        var eActivityDetId = ASPxClientTextBox.Cast("DetId");

        popup.callbackUrl = '@Url.Action("ViewBatch_PopupListOnDemandPartial", "ProductionTaskActivity")'
            + '?Id=' + (eId != null ? eId.GetValue() : '')
            + '&DetId=' + itemDetId
            + '&ActivityDetId=' + (eActivityDetId != null ? eActivityDetId.GetValue() : '');
        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }

</script>

