    function Operator_BeginCallback(s, e) {
        var rowIndex = gvDetail.GetFocusedRowIndex();
        var routing = gvDetail.batchEditApi.GetCellValue(rowIndex, "RoutingCode");
        e.customArgs["RoutingCode"] = routing;
    }

    function gvDetailOnBatchEditStartEditing(s, e) {
        if (e.focusedColumn.fieldName !== "OperatorId") return;
        var routingCode = s.batchEditApi.GetCellValue(e.visibleIndex, "RoutingCode");

            $.ajax({
                url: '@Url.Action("GetOperatorByRouting", "ProductionTaskActivity")',
                type: 'POST',
                data: { routingCode: routingCode },
                success: function (data) {

                    var editor = s.GetEditor("OperatorId");

                    editor.ClearItems();

                    for (var i = 0; i < data.length; i++) {
                        editor.AddItem(data[i].Name, data[i].Code);
                    }
                }
            });
    }

    function gvProductionTaskActivityContentDetail_OperatorOnChanged(s, e) {
        var visibleIndex = gvDetail.GetFocusedRowIndex();
        var grid = gvDetail;
        var text = s.GetText();
        var value = s.GetValue();

        grid.batchEditApi.SetCellValue(e.visibleIndex, "OperatorId", value);
        gvProessCardContentDetail_OperatorName.SetValue(text);
    }

