@model Models.Production.ProductionScheduleModel


@{    
    int userId = (int)Session["userId"];
    ViewBag.Title = "Production Schedule";
    ViewBag.UserId = Model.UserId;

    string canUpdate = "Y";

    string strCanUpdate = Models._Ef.DbProvider.dbApp.Database.SqlQuery<string>(@"
        SELECT TOP 1 COALESCE(T1.""IsAccess"", 'N')
        FROM ""Tm_User"" T0X
        INNER JOIN ""Tm_Role"" T0 ON T0.""Id"" = T0X.""RoleId""
        INNER JOIN ""Tm_Role_Auth"" T1 ON T1.""Id"" = T0.""Id""
        WHERE T0X.""Id"" = 1 AND T1.""MenuCode"" = 'ProductionSchedule/Update'
        ", userId).FirstOrDefault();

    if (userId != 1)
    {
        canUpdate = strCanUpdate;
    }

}

<script type="text/javascript">
    var canUpdate = '@canUpdate.ToString()';
    var timer;

    $(document).ready(function () {
        SetBtnStatus();
        MyTimer();
    }
    );

    $(window).on('resize', AdjustGridViewHeight);
    $(document).ready(AdjustGridViewHeight);

    function SetBtnStatus() {
        var grpBtnAdd = formLayouBtn.GetItemByName('grpBtnSave');
        var btnUpdate = ASPxClientButton.Cast('btnUpdate');
         
        btnUpdate.SetEnabled(false);
        if (canUpdate == "Y") { 
            btnUpdate.SetEnabled(true);
        }
    }

    function MyTimer() {
        var sec = '@System.Configuration.ConfigurationManager.AppSettings["RefreshSeconds"]';
        clearInterval(timer);
        timer = setInterval(function () {
            $('#timer').text(sec--);
            if (sec == -1) {
                clearInterval(timer);
                OnClickBtnRefresh();
                MyTimer(); 
            }
        }, 1000);

    }

    function AdjustGridViewHeight() {
        var gridEl = document.getElementById('gvProductionScheduleReferenceDetail');
        if (!gridEl) return;

        var top = gridEl.getBoundingClientRect().top;
        var bottomMargin = 50;
        var target = window.innerHeight - top - bottomMargin;
        if (target < 150) target = 150;

        setGridHeight(target);

        setTimeout(function () {
            var overflow = document.documentElement.scrollHeight - window.innerHeight;
            if (overflow > 0) {
                var corrected = Math.max(target - overflow - 2, 150);
                setGridHeight(corrected); 
            }
        }, 50);
    }
</script>



<script type="text/javascript">

    var beforeSaveActiveTabName = '';
    var beforeSaveActiveTabIndex = 0;

    $.ajaxSetup({
        cache: false
    });

    function OnBegin() {
        loadingPanel.Show();

    }


    var msgCount = 0;
    function OnSuccess() {

        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());

    }


    function OnSuccessMsgBox() {

        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());
        loadingPanel.Hide();

        popupSuccess.Show();
        setTimeout(function () { popupSuccess.Hide(); }, 1000);

    }

    function OnFailure(jqXhr, textStatus, errorThrown) {
        if (beforeSaveActiveTabName != '') {
            var tab = ASPxClientTabControl.Cast(beforeSaveActiveTabName);
            tab.SetActiveTabIndex(beforeSaveActiveTabIndex);
            beforeSaveActiveTabName = '';
        }

        if (jqXhr.responseText.substring(0, 12) == "[VALIDATION]") {
            $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + jqXhr.responseText + '</p>' + $("#MessageText").html());

            loadingPanel.Hide()
            alert(jqXhr.responseText);
        }
        else {
            // untuk error yg tidak ter capture di validation
            var doc = jqXhr.responseText.match(/.*<title>([\s\S]*)<\/title>.*/);
            if (doc != null) {
                $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + doc[1] + '</p>' + $("#MessageText").html());

                loadingPanel.Hide();
                alert(doc[1]);
            }

        }

    }

    function OnComplete() {
        loadingPanel.Hide();
    }


    function BeforeSave() {

        //var tab = ASPxClientTabControl.Cast("TabDetail");
        //var tabPageCount = tab.GetTabCount();
        //for (var i = 0; i < tabPageCount; i++) {
        //    tab.SetActiveTabIndex(i);
        //    if (!($("#formDetail").valid())) {
        //        var validator = $("#formDetail").validate();
        //        var errors = validator.numberOfInvalids();
        //        if (errors) {
        //            // alert( validator.errorList[0].message);
        //            validator.errorList[0].element.focus();

        //        }
        //        return false;
        //    }
        //}

        return true;

    }

    function getFormData() {
        if (typeof gvProductionScheduleReferenceDetail !== 'undefined') {
            gvProductionScheduleReferenceDetail.batchEditApi.EndEdit();
        }
        return GetGvDetails('gvProductionScheduleReferenceDetail') || {};
    }

    // DETAIL (operator) saja -> array
    function getFormDataDetail() {
        // pastikan editor grid detail commit dulu
        (window.detailGrids || []).forEach(function (name) {
            var g = ASPxClientGridView.Cast(name);
            if (g) g.batchEditApi.EndEdit();
        });

        var operators = [];
        for (var k in window.operatorChanges) {
            if (window.operatorChanges.hasOwnProperty(k)) operators.push(window.operatorChanges[k]);
        }
        return operators;
    }

    function OnClickBtnSave(s, e) {
        var formData = getFormData();                              // master (root)
        formData.OperatorsJson = JSON.stringify(getFormDataDetail()); // detail (1 field string) 
        $.ajax({
            type: "POST",
            url: '@Url.Action("Update", "ProductionSchedule")',
            data: formData,
            beforeSend: function () { OnBegin(); },
            success: function (response) {
                RefreshAfterSuccess(response);
                OnSuccessMsgBox();
                window.operatorChanges = {};        // reset setelah sukses
                OnClickBtnRefresh(s, e);
            },
            error: function (jqXhr, textStatus, errorThrown) { OnFailure(jqXhr, textStatus, errorThrown); },
            complete: function () { OnComplete(); }
        });
    }

    function RefreshAfterSuccess(response) {
        //var tab = ASPxClientTabControl.Cast("TabDetail");
        //if (tab.GetActiveTabIndex != 0) {
        //    tab.SetActiveTabIndex(0);
        //}

        $("#contentForm").html(response);

        $.validator.unobtrusive.parse("#formDetail");

        MVCxClientUtils.FinalizeCallback();

    }

    function OnClickBtnRefresh(s, e) {
        $.ajax({
             type: "POST",
             url: "@Url.Action("DetailPartial", "ProductionSchedule")",
             beforeSend: function () {
                 OnBegin();
             },

             success: function (response) {
                 RefreshAfterSuccess(response);
                 OnSuccess();
             },

             error: function (jqXhr, textStatus, errorThrown) {
                 OnFailure(jqXhr, textStatus, errorThrown)
             },

             complete: function () {
                 OnComplete()
             }
        });

    }

    function OnClickChooseTransNo(s, e, Id) {
        var guid = CreateGuid();
        window.open('', guid);
        SubmitForm(guid, '@Url.Action("Detail", "ProcessCard")', 'post', {
            Id: Id
        });
    }

    function gvProductionScheduleReferenceDetailInitCallback(s, e) {
        AdjustGridViewHeight();
        InitReferenceRowDragDrop();
    }

    function gvProductionScheduleReferenceDetailBeginCallback(s, e) {

    }

    function gvProductionScheduleReferenceDetailEndCallback(s, e) {
        AdjustGridViewHeight();

        // Grid dirender ulang tiap callback, jadi handler drag harus dipasang lagi.
        InitReferenceRowDragDrop();
    }

    //-------------------------------------------------------------------------
    // Drag & drop baris -> VisOrder dihitung ulang 1..N lalu disimpan.
    //
    // ASPxGridView DevExpress 20.1 tidak punya drag & drop baris bawaan, jadi
    // dipakai HTML5 drag & drop biasa: tidak menambah library baru.
    //-------------------------------------------------------------------------
    var referenceDragSourceIndex = null;

    function ReferenceRowPrefix() {
        return 'gvProductionScheduleReferenceDetail_DXDataRow';
    }

    function ReferenceRowIndexOf(tr) {
        var prefix = ReferenceRowPrefix();
        if (!tr || !tr.id || tr.id.indexOf(prefix) !== 0) { return null; }

        var n = parseInt(tr.id.substring(prefix.length), 10);
        return isNaN(n) ? null : n;
    }

    function InitReferenceRowDragDrop() {
        var grid = (typeof gvProductionScheduleReferenceDetail !== 'undefined')
            ? gvProductionScheduleReferenceDetail : null;
        if (grid == null) { return; }

        var rows = document.querySelectorAll('tr[id^="' + ReferenceRowPrefix() + '"]');

        for (var i = 0; i < rows.length; i++) {
            var tr = rows[i];

            // Jangan pasang dua kali kalau elemennya belum diganti.
            if (tr.getAttribute('data-dnd') === 'Y') { continue; }
            tr.setAttribute('data-dnd', 'Y');

            tr.draggable = true;
            tr.style.cursor = 'move';

            tr.addEventListener('dragstart', function (ev) {
                referenceDragSourceIndex = ReferenceRowIndexOf(this);
                if (ev.dataTransfer) {
                    ev.dataTransfer.effectAllowed = 'move';
                    // Firefox butuh data terisi supaya drag nya jalan.
                    ev.dataTransfer.setData('text/plain', String(referenceDragSourceIndex));
                }
            });

            tr.addEventListener('dragover', function (ev) {
                ev.preventDefault();
                if (ev.dataTransfer) { ev.dataTransfer.dropEffect = 'move'; }
            });

            tr.addEventListener('drop', function (ev) {
                ev.preventDefault();
                ev.stopPropagation();

                var targetIndex = ReferenceRowIndexOf(this);
                ReferenceRowDropped(referenceDragSourceIndex, targetIndex);
                referenceDragSourceIndex = null;
            });
        }
    }

    function ReferenceRowDropped(sourceIndex, targetIndex) {
        if (sourceIndex == null || targetIndex == null) { return; }
        if (sourceIndex === targetIndex) { return; }

        var grid = gvProductionScheduleReferenceDetail;
        var count = grid.GetVisibleRowsOnPage();

        // Urutan Id saat ini, lalu baris sumber dipindah ke posisi tujuan.
        var ids = [];
        for (var i = 0; i < count; i++) {
            ids.push(grid.GetRowKey(i));
        }

        var moved = ids.splice(sourceIndex, 1)[0];
        ids.splice(targetIndex, 0, moved);

        $.ajax({
            type: "POST",
            traditional: true,
            url: '@Url.Action("UpdateVisOrder", "ProductionSchedule")',
            data: { ids: ids },
            beforeSend: function () { OnBegin(); },
            success: function () {
                // Baca ulang dari database supaya yang tampil benar-benar urutan tersimpan,
                // bukan hasil geser di layar saja.
                grid.PerformCallback();
            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown);
            },
            complete: function () { OnComplete(); }
        });
    }


    function setGridHeight(height) {
        if (typeof gvProductionScheduleReferenceDetail !== 'undefined') {
            gvProductionScheduleReferenceDetail.SetHeight(height);
        }
    }


</script>



@Html.Partial("Partial/ProductionSchedule_Form_Btn_Partial")

<script type="text/javascript">

    var textSeparator = ";";
    function OnListBoxSelectionChanged(listBox, args) {
        if (args.index == 0)
            args.isSelected ? listBox.SelectAll() : listBox.UnselectAll();
        UpdateSelectAllItemState();
        UpdateText();

        //------------------
        //-Untuk valuenya
        //------------------
        var s = listBox;
        var items = new Array();
        for (i in s.GetSelectedIndices()) {
            var j = s.GetSelectedIndices()[i];
            if (j != 0) {
                items.push(s.GetItem(parseInt(j)).value);
            }
        }
        temp = (JSON.stringify(items));
        var txt = ASPxClientTextBox.Cast('ItemCode');
        if (temp == '[]') { temp = ''; }
        txt.SetValue(temp);

    }
    function UpdateSelectAllItemState() {
        IsAllSelected() ? checkListBox.SelectIndices([0]) : checkListBox.UnselectIndices([0]);
    }   
    function IsAllSelected() {
        for (var i = 1; i < checkListBox.GetItemCount(); i++)
            if (!checkListBox.GetItem(i).selected)
                return false;
        return true;
    }
    function UpdateText() {
        var selectedItems = checkListBox.GetSelectedItems();
        checkComboBox.SetText(GetSelectedItemsText(selectedItems));
    }
    function SynchronizeListBoxValues(dropDown, args) {
        checkListBox.UnselectAll();
        var texts = dropDown.GetText().split(textSeparator);
        var values = GetValuesByTexts(texts);
        checkListBox.SelectValues(values);
        UpdateSelectAllItemState();
        UpdateText(); // for remove non-existing texts
    }
    function GetSelectedItemsText(items) {
        var texts = [];
        for (var i = 0; i < items.length; i++)
            if (items[i].index != 0)
                texts.push(items[i].text);
        return texts.join(textSeparator);
    }
    function GetValuesByTexts(texts) {
        var actualValues = [];
        var item;
        for (var i = 0; i < texts.length; i++) {
            item = checkListBox.FindItemByText(texts[i]);
            if (item != null)
                actualValues.push(item.value);
        }
        return actualValues;
    }

    window.detailGrids = window.detailGrids || [];
    window.operatorChanges = window.operatorChanges || {};
    window.curEditIndex = -1;
     
    function gvDetailOnInit(s, e) {
        if (window.detailGrids.indexOf(s.name) === -1) window.detailGrids.push(s.name);
    }

    function gvDetailBatchStartEditing(s, e) {
        if (e.focusedColumn && e.focusedColumn.fieldName === "OperatorId") {
            var taskId = s.batchEditApi.GetCellValue(e.visibleIndex, "ProductionTaskId");
            var status = s.batchEditApi.GetCellValue(e.visibleIndex, "ProductionStatus");
            var hasTask = (taskId !== null && taskId !== "" && typeof taskId !== "undefined");
            if (hasTask && status !== "Closed") { e.cancel = true; return; }
        }
        window.curEditIndex = e.visibleIndex;
    }

    // TANGKAP operator ke map saat combo berubah
    function gvOperatorOnChanged(s, e, gridName) {
        var grid = ASPxClientGridView.Cast(gridName);
        if (!grid) return;
        var idx = window.curEditIndex;
        if (idx === null || typeof idx === "undefined" || idx < 0) return;

        grid.batchEditApi.SetCellValue(idx, "OperatorId", s.GetValue());
        grid.batchEditApi.SetCellValue(idx, "OperatorName", s.GetText());

        var id = grid.batchEditApi.GetCellValue(idx, "Id");
        var detId = grid.batchEditApi.GetCellValue(idx, "DetId");
        var taskId = grid.batchEditApi.GetCellValue(idx, "ProductionTaskId");
        var taskStat = grid.batchEditApi.GetCellValue(idx, "ProductionStatus");

        window.operatorChanges[id + "_" + detId] = {
            Id: id,
            DetId: detId,
            ProductionTaskId: taskId,
            ProductionTaskStatus: taskStat,
            OperatorId: s.GetValue(),
            OperatorName: s.GetText()
        };
    }


    // reset map operator setelah sukses simpan (panggil di dalam success OnClickBtnSave,
    // atau tambahkan baris ini di RefreshAfterSuccess)
    function ResetOperatorChanges() {
        window.operatorChanges = {};
    }

</script>


