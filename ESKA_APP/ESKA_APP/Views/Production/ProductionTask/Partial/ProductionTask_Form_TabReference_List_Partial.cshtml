@using Models;

@{ 
    int userId = (int)Session["userId"];
    var Id = Convert.ToInt64(Request["cbId"]);
    bool canUpdate = true; 
}

@Html.DevExpress().CardView(settings =>
{
    settings.Name = "cvProductionTaskReferenceDetail";
    settings.KeyFieldName = "Id";
    settings.Width = Unit.Percentage(100);

    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;
    settings.Settings.VerticalScrollableHeight = 300;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;
    settings.SettingsPager.SettingsTableLayout.ColumnCount = 1;

    settings.CallbackRouteValues = new { Controller = "ProductionTask", Action = "TabTransListPartial" };

    settings.Width = Unit.Percentage(100);
    settings.Height = Unit.Percentage(100);

    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;

    settings.Columns.Add("Id", "Id").Visible = false;


    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemCode";
        column.Name = "ItemCode";
        column.Caption = "Item Code";
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemName";
        column.Name = "ItemName";
        column.Caption = "Item Name";
    });


    settings.Columns.Add(column =>
    {
        column.FieldName = "QuantityPlanned";
        column.Name = "QuantityPlanned";
        column.Caption = "Target";
        column.SetDataItemTemplateContent(c =>
        {
            var qty = DataBinder.Eval(c.DataItem, "QuantityPlanned");
            var uom = DataBinder.Eval(c.DataItem, "Uom");
            ViewContext.Writer.Write(
                string.Format("{0:N3} {1}", qty, uom)
            );
        });
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Status";
        column.Name = "Status";
        column.Caption = "Status";

    });

    settings.Columns.Add(column =>
    {
        column.Name = "ActionRow";
        column.Caption = "";
        column.SetDataItemTemplateContent(c =>
        {
            var id = DataBinder.Eval(c.DataItem, "Id");
            var status = DataBinder.Eval(c.DataItem, "Status");

            ViewContext.Writer.Write(
                "<div style='display:flex;justify-content:space-between;align-items:center;border-top:1px dashed #ccc;padding-top:6px;'>" +
                "<span>" +
                    "<a href=\"javascript:void(0);\" onclick=\"OnStartTask(" + id + ");\" style=\"color:#2196F3;text-decoration:underline;\">[ START ]</a>" +
                "</span>" +
                "<span style='font-weight:bold;'>" +
                    "<a href=\"javascript:void(0);\" onclick=\"OnCloseTask(" + id + ");\" style=\"color:#F54927;text-decoration:underline;\">[ CLOSE ]</a>" +
                "</span>" +
                "</div>"
            );
        });
    });

    settings.SettingsPager.PageSizeItemSettings.Visible = false;
    settings.ClientSideEvents.BeginCallback = "cvProductionTaskReferenceDetailBeginCallback";

}).Bind(Model).GetHtml()



