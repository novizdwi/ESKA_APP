@if (false)
{ <script src="~/Scripts/ASPxScriptIntelliSense.js" type="text/javascript"></script> }

@{
    ViewBag.Title = "GRPO Summary";

    DateTime transDateFrom = (DateTime)ViewBag.TransDate_From;
    DateTime transDateTo = (DateTime)ViewBag.TransDate_To;
}


<script type="text/javascript">

    $.ajaxSetup({
        cache: false
    });

    function OnBegin() {
        loadingPanel.Show();
    }

    var msgCount = 0;
    function OnSuccess() {

        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());

    }

    function OnFailure(jqXhr, textStatus, errorThrown) {

        if (jqXhr.responseText.substring(0, 12) == "[VALIDATION]") {
            $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + jqXhr.responseText + '</p>' + $("#MessageText").html());

            loadingPanel.Hide()
            alert(jqXhr.responseText);
        }
        else {
            // untuk error yg tidak ter capture di validation
            var doc = jqXhr.responseText.match(/.*<title>([\s\S]*)<\/title>.*/);
            $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + doc[1] + '</p>' + $("#MessageText").html());

            loadingPanel.Hide();
            alert(doc[1]);
        }

    }

    function OnComplete() {
        loadingPanel.Hide();
    }


    function OnClickBtnShow(s, e) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("ChartPartial", "ReportGrpoSummary")',
            data: {
                TransDate_From: TransDate_From.GetValueString(),
                TransDate_To: TransDate_To.GetValueString()
            },
            beforeSend: function () {
                OnBegin();
            },
            success: function (response) {
                $("#contentChart").html(response);
                MVCxClientUtils.FinalizeCallback();
                OnSuccess();

            },
            error: function (jqXhr, textStatus, errorThrown) {
                OnFailure(jqXhr, textStatus, errorThrown)
            },
            complete: function () {
                OnComplete()
            }
        });

    }

</script>


@Html.DevExpress().Panel(settings =>
{
    settings.Name = "pageToolbarPanel";
    settings.ControlStyle.CssClass = "page-toolbar-wrapper";
    settings.ClientSideEvents.Init = "onPageToolbarInit";
    settings.SetContent(() =>
    {
        @Html.DevExpress().Menu(menuSettings =>
        {
            menuSettings.Name = "pageToolbar";

            menuSettings.ItemAutoWidth = false;
            menuSettings.AllowSelectItem = false;
            menuSettings.ApplyItemStyleToTemplates = true;

            menuSettings.SettingsAdaptivity.Enabled = true;
            menuSettings.SettingsAdaptivity.EnableAutoHideRootItems = true;
            menuSettings.SettingsAdaptivity.EnableCollapseRootItemsToIcons = true;
            menuSettings.SettingsAdaptivity.CollapseRootItemsToIconsAtWindowInnerWidth = 600;

            menuSettings.Width = Unit.Percentage(100);
            menuSettings.ControlStyle.SeparatorWidth = Unit.Pixel(0);
            menuSettings.ControlStyle.CssClass = "page-toolbar";

            menuSettings.Styles.Item.CssClass = "item";
            menuSettings.Styles.Item.VerticalAlign = VerticalAlign.Middle;

            menuSettings.Images.Item.Width = Unit.Pixel(16);
            menuSettings.Images.Item.Height = Unit.Pixel(16);

            menuSettings.Items.Add(item =>
            {
                item.Enabled = false;
                item.SetTemplateContent(template => ViewContext.Writer.Write("<h1>GRPO Summary</h1>"));
                item.ItemStyle.Width = Unit.Percentage(100);
            });

        }).GetHtml();

    });
}).GetHtml()


<div id="contentForm" style="padding-top: 79px;">

    @Html.DevExpress().FormLayout(settings =>
    {
        settings.Name = "formLayoutFilter";
        settings.EncodeHtml = false;
        settings.Width = Unit.Pixel(620);
        settings.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 600;

        var group = settings.Items.AddGroupItem(groupSettings =>
        {
            groupSettings.Caption = "Filter";
            groupSettings.SettingsItemHelpTexts.Position = HelpTextPosition.Bottom;
            groupSettings.GroupBoxDecoration = GroupBoxDecoration.None;
            groupSettings.ColCount = 3;
            groupSettings.SettingsItems.ShowCaption = DefaultBoolean.True;

            groupSettings.Items.Add(itemSettings =>
            {
                itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.DateEdit;
                itemSettings.Caption = "Trans Date From";

                var txt = (DateEditSettings)itemSettings.NestedExtensionSettings;
                txt.Name = "TransDate_From";

                txt.ControlStyle.CssClass = "editornoimage";
                txt.Properties.NullText = "dd/MM/yyyy";
                txt.Properties.EditFormat = EditFormat.Custom;
                txt.Properties.EditFormatString = "dd/MM/yyyy";
                txt.Properties.DisplayFormatInEditMode = true;
                txt.Width = 100;

                txt.Date = transDateFrom;
            });

            groupSettings.Items.Add(itemSettings =>
            {
                itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.DateEdit;
                itemSettings.Caption = "Trans Date To";

                var txt = (DateEditSettings)itemSettings.NestedExtensionSettings;
                txt.Name = "TransDate_To";

                txt.ControlStyle.CssClass = "editornoimage";
                txt.Properties.NullText = "dd/MM/yyyy";
                txt.Properties.EditFormat = EditFormat.Custom;
                txt.Properties.EditFormatString = "dd/MM/yyyy";
                txt.Properties.DisplayFormatInEditMode = true;
                txt.Width = 100;

                txt.Date = transDateTo;
            });

            groupSettings.Items.Add(itemSettings =>
            {
                itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.Button;
                itemSettings.Caption = " ";

                var btnSettings = (ButtonSettings)itemSettings.NestedExtensionSettings;
                btnSettings.Name = "btnShow";
                btnSettings.Text = "Tampilkan";
                btnSettings.Width = Unit.Pixel(110);
                btnSettings.ClientSideEvents.Click = "OnClickBtnShow";

                btnSettings.ImagePosition = ImagePosition.Left;
                btnSettings.Images.Image.Url = "~/Content/Images/buttonnew/refresh.png";
                btnSettings.Images.Image.Width = Unit.Pixel(16);
                btnSettings.Images.Image.Height = Unit.Pixel(16);
                btnSettings.Styles.Style.Paddings.Padding = 0;
            });
        });

    }).GetHtml()

    <div id="contentChart" style="padding: 10px;">
        <div style="padding: 30px; color: #888; font-size: 14px;">
            Pilih rentang tanggal lalu klik Tampilkan.
        </div>
    </div>

</div>


@Html.DevExpress().LoadingPanel(
    settings =>
    {
        settings.Name = "loadingPanel";
        settings.Modal = true;
        settings.ContainerElementID = "contentChart";
        settings.Styles.LoadingDiv.BackColor = System.Drawing.Color.White;
    }).GetHtml()
