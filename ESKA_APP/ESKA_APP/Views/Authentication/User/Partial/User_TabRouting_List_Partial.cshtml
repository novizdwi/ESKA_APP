@using Models;
@{

    var Id = Convert.ToInt32(Request["cbId"]);
    if (ViewBag.Id != null)
    {
        Id = ViewBag.Id;
    }

}

@Html.DevExpress().GridView(settings =>
{

    settings.Name = "gvUserRoutingDetail";
    settings.KeyFieldName = "RoutingCode_";
    settings.CommandColumn.Visible = false;
    settings.CallbackRouteValues = new { Controller = "User", Action = "TabRoutingListPartial" };

    settings.Width = Unit.Percentage(100);

    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;
    settings.Settings.VerticalScrollableHeight = 250;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;

    settings.SettingsEditing.Mode = GridViewEditingMode.Batch;
    settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
    settings.SettingsEditing.BatchEditSettings.EditMode = GridViewBatchEditMode.Row;
    settings.SettingsEditing.BatchEditSettings.StartEditAction = GridViewBatchStartEditAction.Click;
    settings.SettingsEditing.NewItemRowPosition = GridViewNewItemRowPosition.Bottom;

    settings.Settings.ShowFilterRow = true;
    settings.Settings.ShowFilterRowMenu = true;

    settings.CommandColumn.Visible = false;
    settings.CommandColumn.ShowDeleteButton = false;
    settings.CommandColumn.ShowNewButtonInHeader = false;
    settings.CommandColumn.Width = 50;
    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;

    settings.Columns.Add("Id", "Id").Visible = false;

    settings.Columns.Add(column =>
    {
        column.FieldName = "IsTick";
        column.Name = "IsTick";
        column.Caption = "#";
        column.ColumnType = MVCxGridViewColumnType.CheckBox;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.Settings.AllowHeaderFilter = DefaultBoolean.False;

        column.Width = 60;

        var chk = column.PropertiesEdit as CheckBoxProperties;
        chk.ValueType = typeof(string);
        chk.ValueChecked = "Y";
        chk.ValueUnchecked = "N";
    });

    settings.Columns.Add(column =>
    {
        column.Caption = "Routing Code";
        column.Name = "RoutingCode_";
        column.FieldName = "RoutingCode_";
        column.Settings.AllowSort = DefaultBoolean.False;
        column.Width = 100;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        column.CellStyle.ForeColor = System.Drawing.Color.Black;
    });

    settings.Columns.Add(column =>
    {
        column.Caption = "Routing Name";
        column.Name = "RoutingName_";
        column.FieldName = "RoutingName_";
        column.Settings.AllowSort = DefaultBoolean.False;
        column.Width = 240;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        column.CellStyle.ForeColor = System.Drawing.Color.Black;
    });


    settings.Columns.Add(column =>
    {
        column.Caption = "Level";
        column.Name = "Level_";
        column.FieldName = "Level_";
        column.Settings.AllowSort = DefaultBoolean.False;
        column.Width = 100;
        column.ReadOnly = true;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        column.CellStyle.ForeColor = System.Drawing.Color.Black;
    });


    settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;

    settings.CellEditorInitialize = (s, e) =>
    {
        ASPxEdit editor = (ASPxEdit)e.Editor;
        editor.ValidationSettings.Display = Display.Dynamic;
    };

    settings.CellEditorInitialize = (s, e) =>
    {
        ASPxEdit editor = (ASPxEdit)e.Editor;
        editor.ValidationSettings.Display = Display.Dynamic;
    };

    settings.ClientSideEvents.BeginCallback = "gvUserRoutingDetailOnBeginCallback";
}).Bind(Model).GetHtml()
