@using Models;
@using Models._Cfl;
@{

    var Id = Convert.ToInt64(Request["cbId"]);
    if (ViewBag.Id != null)
    {
        Id = ViewBag.Id;
    }

    // Kolom Mesin Production & Department hanya bisa di-edit saat dokumen masih Draft.
    bool isDraft = ViewBag.ReadOnly != null && !(bool)ViewBag.ReadOnly;

}

@Html.DevExpress().GridView(settings =>
{
    settings.Name = "gvReceiptDetail";//"gvDetail";
    settings.KeyFieldName = "DetId";
    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;
    //settings.Settings.VerticalScrollableHeight = 350;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;

    settings.Width = Unit.Percentage(100);
    settings.Height = Unit.Percentage(100);

    settings.CallbackRouteValues = new { Controller = "ReProcess", Action = "TabReceiptDetailListPartial" };

    settings.SettingsEditing.Mode = GridViewEditingMode.Batch;//GridViewEditingMode.Batch;
    settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
    settings.SettingsEditing.BatchEditSettings.EditMode = GridViewBatchEditMode.Row;
    settings.SettingsEditing.BatchEditSettings.StartEditAction = GridViewBatchStartEditAction.Click;
    // Standalone: baris ditambah via tombol "Add Item" (CFL).
    // (Enum DevExpress v20.1 tidak punya nilai None; biarkan default.)

    //settings.Settings.ShowFilterRow = true;
    //settings.Settings.ShowFilterRowMenu = true;

    settings.CommandColumn.Visible = true;
    settings.CommandColumn.Width = 70;
    if (isDraft)
    {
        settings.CommandColumn.CustomButtons.Add(new GridViewCommandColumnCustomButton { ID = "btnDeleteItem", Text = "Delete" });
        settings.ClientSideEvents.CustomButtonClick = "gvReceiptDetailOnCustomButtonClick";
    }
    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;
    settings.Columns.Add("Id", "Id").Visible = false;
    settings.Columns.Add("DetId", "DetId").Visible = false;
    //settings.Columns.Add("IdPDO", "IdPDO").Width = 0;

    settings.Columns.Add(column =>
    {
        column.FieldName = "RowNo";
        column.Name = "RowNo";
        column.Caption = "No.";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 45;
        column.ReadOnly = true;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.Settings.AllowAutoFilter = DefaultBoolean.False;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemCode";
        column.Name = "ItemCode";
        column.Caption = "Item Code";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 220;
        column.Settings.AllowSort = DefaultBoolean.False;
        //column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ClientInstanceName = "ItemCode";
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(90);

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemName";
        column.Name = "ItemName";
        column.Caption = "Item Name";
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 220;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(90);

    });


    settings.Columns.Add(column =>
    {
        column.FieldName = "Quantity";
        column.Name = "Quantity";
        column.Caption = "Quantity";

        // Standalone: Quantity diisi user (editable saat Draft).
        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = !isDraft;
        if (!isDraft)
        {
            column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        }

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(95);
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Uom";
        column.Name = "Uom";
        column.Caption = "Uom";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(95);
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "WhsCode";
        column.Name = "WhsCode";
        column.Caption = "Whse";

        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        // Whse bisa dipilih (ComboBox daftar gudang) saat Draft; read-only setelah posting.
        column.ReadOnly = !isDraft;

        column.ColumnType = MVCxGridViewColumnType.ComboBox;
        var cbo = column.PropertiesEdit as ComboBoxProperties;
        cbo.DataSource = Models._Utils.GeneralGetList.GetWarehouses();
        cbo.TextField = "WhsCode";
        cbo.ValueField = "WhsCode";
        cbo.ValueType = typeof(string);
        cbo.DropDownStyle = DropDownStyle.DropDownList;
        cbo.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

        if (!isDraft)
        {
            column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        }
    });


    settings.Columns.Add(column =>
    {
        column.FieldName = "Netto";
        column.Name = "Netto";
        column.Caption = "Netto";
        column.Settings.AllowSort = DefaultBoolean.False;
        // column.ReadOnly = true;
        column.Width = 120;

        column.SetDataItemTemplateContent(c =>
        {
            var visibleIndex = c.VisibleIndex;
            var detId = DataBinder.Eval(c.DataItem, "DetId");
            var quantity = DataBinder.Eval(c.DataItem, "Netto");

            Html.DevExpress().ButtonEdit(s =>
            {
                s.Name = "gvIssueAndReceiptContentDetail_Netto_" + visibleIndex;
                s.Properties.ClientInstanceName = "gIssueAndReceiptContentDetail_Netto_" + visibleIndex;

                // tampilkan value
                s.Text = Convert.ToDecimal(quantity).ToString("N0");

                s.ReadOnly = true;
                s.Width = 100;

                s.Properties.Buttons.Clear();

                EditButton btn = new EditButton();
                btn.Text = "";
                btn.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                btn.Image.Width = 15;

                s.Properties.Buttons.Add(btn);

                s.Properties.ClientSideEvents.ButtonClick = string.Format("function(s, e) {{ BtnCflNettoReceiptPopupListOnClick(s, e, '{0}'); }}", detId);

            }).Render();
        });
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Value";
        column.Name = "Value";
        column.Caption = "Value";

        // Value = (Netto / Total Netto Receipt) x Total Cost Issue, diisi otomatis saat Post (read-only).
        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        column.PropertiesEdit.DisplayFormatString = "{0:N2}";

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(95);
    });

    settings.TotalSummary.Add(new ASPxSummaryItem()
    {
        FieldName = "Netto",
        SummaryType = DevExpress.Data.SummaryItemType.Sum,
        DisplayFormat = "Netto : {0:N0}",
        ShowInColumn = "Netto"
    });

    settings.TotalSummary.Add(new ASPxSummaryItem()
    {
        FieldName = "Value",
        SummaryType = DevExpress.Data.SummaryItemType.Sum,
        DisplayFormat = "Value : {0:N2}",
        ShowInColumn = "Value"
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "MsnPrd";
        column.Name = "MsnPrd";
        column.Caption = "Mesin Production";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = !isDraft;
        if (!isDraft)
        {
            column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        }

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(95);
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Department";
        column.Name = "Department";
        column.Caption = "Department";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = !isDraft;
        if (!isDraft)
        {
            column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        }

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(95);
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Price";
        column.Name = "Price";
        column.Caption = "Price";

        // Price = Value / Quantity, dihitung otomatis saat Post (read-only).
        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 120;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        column.PropertiesEdit.DisplayFormatString = "{0:N2}";

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.Width = Unit.Percentage(95);
    });

    settings.Settings.ShowFooter = true;

    settings.ClientSideEvents.BeginCallback = "gvReceiptDetailOnBeginCallback";
    settings.ClientSideEvents.EndCallback = "gvReceiptDetailOnEndCallback";

    settings.ClientSideEvents.BatchEditStartEditing = "gvReceiptDetailOnBatchEditStartEditing";
    settings.ClientSideEvents.BatchEditEndEditing = "gvReceiptDetailOnBatchEditEndEditing";
    settings.ClientSideEvents.BatchEditRowValidating = "gvReceiptDetailOnBatchEditRowValidating";

}).Bind(Model).GetHtml()

