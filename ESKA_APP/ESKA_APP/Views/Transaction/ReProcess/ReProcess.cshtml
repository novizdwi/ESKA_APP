        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }
    ///-------------------------------------FORM CANCEL-----------------------------------///

    function GetFormData() {
        var formData = $('#formDetail').serializeObject();

        // Kirim perubahan batch kedua grid detail agar edit (Quantity/MsnPrd/Department/Cost/Price)
        // tersimpan saat Update. Diproses di ReProcessService.Update().
        $.extend(formData, {
            IssueDetails_: GetGvDetails('gvIssueDetail'),
            ReceiptDetails_: GetGvDetails('gvReceiptDetail')
        });
        return formData;
    }


