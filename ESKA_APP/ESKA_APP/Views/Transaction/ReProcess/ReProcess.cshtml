<script>
    var isUpdate = false;
    var isDelete = false;

    function gvContentIssueBatchListOnBeginCallback(s, e) {

        if (e.command == "UPDATEEDIT") {
            isUpdate = true;
        }

        if (e.command == "DELETEROW") {
            isDelete = true;
        }
    }

    function gvContentIssueBatchListOnEndCallback(s, e) {

        // Refresh grid lain DITUNDA keluar dari siklus callback grid ini (setTimeout 0),
        // supaya loading panel callback berjalan tertutup dulu -- memanggil PerformCallback
        // grid lain di tengah finalisasi callback membuat loading tidak pernah hilang.
        if (isUpdate) {
            isUpdate = false;
            window.setTimeout(function () {
                popupBatchIssue.PerformCallback();
                if (typeof (gvIssueDetail) != 'undefined' && gvIssueDetail != null && !gvIssueDetail.InCallback()) {
                    gvIssueDetail.PerformCallback();
                }
            }, 0);
        }

        if (isDelete) {
