<script>
    var isUpdate = false;
    function gvContentBatchListOnBeginCallback(s, e, Id, DetId) {
        if (e.command == "UPDATEEDIT") {
            isUpdate = true;
        }
    }

    function gvContentBatchListOnEndCallback(s, e, Id, DetId) {
        if (s.IsNewRowEditing && s.IsNewRowEditing()) {
            s.FocusEditor("Batch");
            popupBatch.PerformCallback();
        }

        if (isUpdate) {

            isUpdate = false;

            popupBatch.PerformCallback();
            gvDetail.PerformCallback();
        }

    }

    function gvContentBatchListOnBatchEditStartEditing(s, e, Id, DetId) {

    }

    function gvContentBatchListOnBatchEditEndEditing(s, e, Id, DetId) {

    }

    function gvContentBatchListOnBatchEditRowValidating(s, e, Id, DetId) {

    }

    function popupBatch_EndCallback(s, e) {
        $.validator.unobtrusive.parse("#Batch_formDetail");
        var popup = ASPxClientPopupControl.Cast("popupBatch");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(400, 100);
        }
