    ///-------------------------------------FORM CANCEL-----------------------------------///

    function GetFormData() {
        var formData = $('#formDetail').serializeObject();

        // Commit dulu sel yang MASIH dalam mode edit. Selama editor sebuah sel masih terbuka,
        // angka yang baru diketik (mis. Quantity) belum masuk ke edit-state batch, sehingga
        // GetGvDetails tidak melihatnya dan nilainya hilang begitu tombol Add/Update diklik --
        // user harus klik ke baris lain dulu supaya qty-nya ikut tersimpan. EndEdit() menutup
        // editor itu lebih dulu (API ASPxClientGridViewBatchEditApi, ada di DevExpress v20.1).
        EndEditGvDetail();

        // Perubahan batch-edit grid item (gvDetail) TIDAK otomatis ikut ter-serialize oleh
        // serializeObject() biasa -- grid ini tidak dikonfigurasi dengan Update/Insert/DeleteRowRouteValues
        // sendiri, jadi perubahannya harus dijembatani manual ke Details_ (dibaca server via
        // Update()/Detail_Update). Sebelumnya baris ini dinonaktifkan (comment) dan salah nama grid
        // ("gvGoodsReceiptPoDetail", padahal nama asli grid = "gvDetail") -- akibatnya Quantity (dan
        // kolom lain) yang diedit di grid tidak pernah tersimpan walau tombol Update diklik.
        var Details_ = GetGvDetails('gvDetail');
        $.extend(formData, { Details_: Details_ });
        return formData;
    }


