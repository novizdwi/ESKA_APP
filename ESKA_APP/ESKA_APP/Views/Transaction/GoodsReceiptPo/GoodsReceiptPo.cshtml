@*-------------------------------------------------
    ViewScale (Timbangan)
    -------------------------------------------------*@
<script>
    var isUpdateScale = false;

    // Dibuka dari kolom Netto pada grid batch (di dalam popupBatch).
    // popupScale dideklarasikan di root view, bukan di dalam form popupBatch,
    // supaya tidak ikut hancur saat popupBatch melakukan callback.
    function BtnScalePopupListOnClick(s, e, detId, detDetId) {
        var popup = ASPxClientPopupControl.Cast("popupScale");

        popup.callbackUrl = '@Url.Action("ViewScale_PopupListOnDemandPartial", "GoodsReceiptPo")'
            + '?Id=' + Id.GetValue() + '&DetId=' + detId + '&DetDetId=' + detDetId;
        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }

    function popupScale_EndCallback(s, e) {
        $.validator.unobtrusive.parse("#Scale_formDetail");
        var popup = ASPxClientPopupControl.Cast("popupScale");
        if (!popup.IsVisible()) {
            loadingPanel.Hide();
            popup.ShowAtPos(430, 130);
        }
    }

    function ViewScale_OnClickBtnCancel(s, e) {
        var popup = ASPxClientPopupControl.Cast("popupScale");
        popup.Hide();
    }

    function gvContentScaleListOnBeginCallback(s, e, Id, DetId, DetDetId) {
        if (e.command == "UPDATEEDIT" || e.command == "DELETEROW") {
            isUpdateScale = true;
        }
    }

    function gvContentScaleListOnEndCallback(s, e, Id, DetId, DetDetId) {
        if (isUpdateScale) {

            isUpdateScale = false;

            // Netto batch = jumlah baris scale -> segarkan grid batch & grid detail.
            var gvBatch = ASPxClientGridView.Cast('gvContentBatchList');
            if (gvBatch != null) {
                gvBatch.PerformCallback();
            }
            if (typeof (gvDetail) != 'undefined' && gvDetail != null) {
                gvDetail.PerformCallback();
            }
        }
    }

    // Tombol "Scale" (Timbang) -> simpan permintaan timbang ke Tp_ScaleStaging.
    function gvContentScaleListOnCustomButtonClick(s, e, Id, DetId, DetDetId) {
        if (e.buttonID == "timbangButton") {
            var detDetDetId = s.GetRowKey(e.visibleIndex);
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveScaleStaging", "GoodsReceiptPo")',
                data: { Id: Id, DetId: DetId, DetDetId: DetDetId, DetDetDetId: detDetDetId },
                beforeSend: function () { OnBegin(); },
                success: function () { OnSuccessMsgBox(); s.PerformCallback(); },
                error: function (jqXhr, textStatus, errorThrown) { OnFailure(jqXhr, textStatus, errorThrown); },
                complete: function () { OnComplete(); }
            });
        }
    }

</script>

