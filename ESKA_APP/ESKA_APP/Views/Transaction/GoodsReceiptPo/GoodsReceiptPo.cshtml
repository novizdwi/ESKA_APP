<script type="text/javascript">
    var IsCanPost_ = '@IsCanPost_';

    var beforeSaveActiveTabName = '';
    var beforeSaveActiveTabIndex = 0;

    $.ajaxSetup({
        cache: false
    });

    function OnBegin() {
        loadingPanel.Show();

    }

    function SetBtnStatus() {

        var btnNew = ASPxClientButton.Cast('btnNew');

        var grpBtnAdd = formLayouBtn.GetItemByName('grpBtnAdd');
        var btnAdd = ASPxClientButton.Cast('btnAdd');

        var grpBtnUpdate = formLayouBtn.GetItemByName('grpBtnUpdate');
        var btnUpdate = ASPxClientButton.Cast('btnUpdate');

        var btnRefresh = ASPxClientButton.Cast('btnRefresh');

        var btnPost = ASPxClientButton.Cast('btnPost');

        var btnCancel = ASPxClientButton.Cast('btnCancel');

        var formMode = '';
        if ((Id.GetValue() == '') || Id.GetValue() == '0') {
            formMode = 'new';
        } else {
            formMode = 'edit';
        }

        btnPost.SetEnabled(false);
        btnCancel.SetEnabled(false);
        switch (formMode) {
            case 'new':

                grpBtnAdd.SetVisible(true);
                grpBtnUpdate.SetVisible(false);

                btnAdd.SetEnabled(true);
                btnUpdate.SetEnabled(false);
                btnRefresh.SetEnabled(false);

                break;
            case 'edit':

                grpBtnAdd.SetVisible(false);
                grpBtnUpdate.SetVisible(true);

                //btnAdd.SetEnabled(false);
                btnRefresh.SetEnabled(true);
                btnUpdate.SetEnabled(true);
                var Status = ASPxClientComboBox.Cast('Status');
                switch (Status.GetValue()) {
                    case 'Draft':
                        btnUpdate.SetEnabled(true);

                        btnPost.SetEnabled(true);
                        btnCancel.SetEnabled(true);
                        break;
                    case 'Posted':
                        btnUpdate.SetEnabled(true);
                        btnCancel.SetEnabled(true);

                        break;
                    case 'Cancel':
                        btnUpdate.SetEnabled(false);

                        break;
                    case 'Closed':
                        btnUpdate.SetEnabled(false);
                        break;
                    default:
                        break;

                }

                break;
            default:

                break;
        }
        if (IsCanPost_ == "N") {
            btnPost.SetEnabled(false);
        }
    }

    var msgCount = 0;
    function OnSuccess() {
        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());

    }


    function OnSuccessMsgBox() {

        $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + 'Action success</p>' + $("#MessageText").html());
        loadingPanel.Hide();

        popupSuccess.Show();
        setTimeout(function () { popupSuccess.Hide(); }, 1000);

    }

    function OnFailure(jqXhr, textStatus, errorThrown) {
        if (beforeSaveActiveTabName != '') {
            var tab = ASPxClientTabControl.Cast(beforeSaveActiveTabName);
            tab.SetActiveTabIndex(beforeSaveActiveTabIndex);
            beforeSaveActiveTabName = '';
        }

        if (jqXhr.responseText.substring(0, 12) == "[VALIDATION]") {
            $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + jqXhr.responseText + '</p>' + $("#MessageText").html());

            loadingPanel.Hide()
            alert(jqXhr.responseText);
        }
        else {
            // untuk error yg tidak ter capture di validation
            var doc = jqXhr.responseText.match(/.*<title>([\s\S]*)<\/title>.*/);
            if (doc != null) {
                $("#MessageText").html('<p>' + '(' + (++msgCount) + ') ' + doc[1] + '</p>' + $("#MessageText").html());

                loadingPanel.Hide();
                alert(doc[1]);
            }

        }

    }

    function OnComplete() {
        loadingPanel.Hide();
    }


    // Tutup editor sel grid item yang sedang terbuka (kalau ada), supaya nilainya
    // dipindahkan dari editor ke edit-state batch.
    function EndEditGvDetail() {
        if (typeof (gvDetail) != 'undefined' && gvDetail != null && gvDetail.batchEditApi) {
            gvDetail.batchEditApi.EndEdit();
        }
    }

    // Cegah Post selagi grid Item (gvDetail) masih punya perubahan yang belum di-Update.
    // Quantity yang dikirim ke SAP saat Post dibaca ulang dari DB (Post TIDAK ikut menyimpan
    // grid), jadi ketikan yang masih ada di buffer browser tidak boleh diam-diam terlewat.
    // Dicek dengan HasChanges() -- BUKAN IsEditing(): BeforeSave() sudah memanggil EndEdit()
    // lebih dulu, sehingga tidak ada lagi sel "sedang diedit", tetapi perubahannya tetap
    // belum tersimpan ke DB. HasChanges() tanpa argumen = ada insert/update/delete tertunda.
    function HasUnsavedGvDetailChanges() {
        if (typeof (gvDetail) == 'undefined' || gvDetail == null || !gvDetail.batchEditApi) {
            return false;
        }

        EndEditGvDetail();

        if (gvDetail.batchEditApi.HasChanges()) {
            alert('Masih ada perubahan pada tabel Item yang belum disimpan. Klik "Update" untuk menyimpannya, lalu coba Post lagi.');
            return true;
        }

        return false;
    }

    // Quantity per baris tidak boleh melebihi Qty Open (sisa PO yang masih boleh diterima).
    //
    // Sengaja membandingkan sendiri per baris, BUKAN lewat batchEditApi.ValidateRows():
    // ValidateRows() mengagregasi hasil validasi SEMUA kolom yang bisa diedit, sehingga
    // kolom lain yang dianggap invalid oleh DevExpress ikut membuatnya false -- dan pesan
    // "Quantity melebihi Qty Open" jadi muncul padahal qty-nya sah (mis. qty 2 vs open 5).
    //
    // Cek ini hanya memberi tahu user lebih awal; penjaga sebenarnya ada di server
    // (GoodsReceiptPoService.Detail_Update dan PostSAP), yang menghitung ulang sisanya --
    // Qty Open di grid hanyalah snapshot saat item ditambahkan dan bisa basi kalau ada
    // GRPO Draft lain untuk baris PO yang sama.
    function ValidateGvDetailQuantity() {
        if (typeof (gvDetail) == 'undefined' || gvDetail == null || !gvDetail.batchEditApi) {
            return true;
        }

        EndEditGvDetail();

        var rowCount = gvDetail.GetVisibleRowsOnPage();
        var errors = [];

        for (var i = 0; i < rowCount; i++) {
            var qty = parseFloat(gvDetail.batchEditApi.GetCellValue(i, "Quantity"));
            var qtyOpen = parseFloat(gvDetail.batchEditApi.GetCellValue(i, "QuantityOpen"));

            // Salah satu tidak terbaca sebagai angka -> lewati; biar server yang memutuskan.
            // Quantity kosong juga bukan urusan di sini (ditolak validasi server saat Post).
            if (isNaN(qty) || isNaN(qtyOpen)) continue;

            if (qty > qtyOpen) {
                var itemCode = gvDetail.batchEditApi.GetCellValue(i, "ItemCode");
                errors.push((itemCode ? itemCode : 'Baris ' + (i + 1))
                    + ': Quantity ' + qty + ' > Qty Open ' + qtyOpen);
            }
        }

        if (errors.length > 0) {
            alert('Quantity tidak boleh melebihi Qty Open:\n\n' + errors.join('\n'));
            return false;
        }

        return true;
    }

    function BeforeSave() {

        var tab = ASPxClientTabControl.Cast("TabDetail");
        var tabPageCount = tab.GetTabCount();
        for (var i = 0; i < tabPageCount; i++) {
            tab.SetActiveTabIndex(i);
            if (!($("#formDetail").valid())) {
                var validator = $("#formDetail").validate();
                var errors = validator.numberOfInvalids();
                if (errors) {
                    // alert( validator.errorList[0].message);
                    validator.errorList[0].element.focus();

                }
                return false;
            }
        }

        if (!ValidateGvDetailQuantity()) {
            return false;
        }

        return true;

    }


    function RefreshAfterSuccess(response) {
       // var tab = ASPxClientTabControl.Cast("TabDetail");

        //if (tab.GetActiveTabIndex != 0) {
        //    tab.SetActiveTabIndex(0);
        //}

        $("#contentForm").html(response);

