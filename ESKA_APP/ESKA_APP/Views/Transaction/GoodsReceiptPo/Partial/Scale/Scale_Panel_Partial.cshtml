@Html.DevExpress().PopupControl(settings =>
{
    settings.Name = "popupScale";
    settings.CallbackRouteValues = new { Controller = "GoodsReceiptPo", Action = "ViewScale_PopupListOnDemandPartial" };
    settings.CloseAction = CloseAction.CloseButton;

    settings.PopupVerticalAlign = PopupVerticalAlign.WindowCenter;
    settings.PopupHorizontalAlign = PopupHorizontalAlign.WindowCenter;

    // Popup ini dibuka DI ATAS popupBatch (yang modal).
    // Modal dimatikan agar tidak tertutup overlay milik popupBatch.
    settings.Modal = false;

    settings.ShowFooter = true;
    settings.AllowDragging = true;
    settings.AllowResize = false;
    settings.ShowRefreshButton = true;
    settings.FooterText = "";
    settings.Styles.Footer.Paddings.Padding = 0;

    settings.ShowPageScrollbarWhenModal = true;

    settings.EnableHotTrack = true;

    settings.CloseAnimationType = AnimationType.Fade;
    settings.PopupAnimationType = AnimationType.Fade;

    settings.LoadContentViaCallback = LoadContentViaCallback.OnFirstShow;
    settings.ClientSideEvents.EndCallback = "popupScale_EndCallback";
    settings.PopupElementID = "ShowButton";
    settings.HeaderText = "Timbangan";

    settings.SetContent(() =>
    {
        Html.RenderPartial("Partial/Scale/Scale_Form_Partial");

    });

    settings.PreRender = (sender, e) =>
    {
        ASPxPopupControl popup = (ASPxPopupControl)sender;
        // Lebar dipaskan dengan total kolom grid (210+50+100+90+110+90 = 650)
        // + scrollbar vertikal & border, agar tepi popup rata dengan kolom terakhir.
        popup.Width = 700;
        popup.Height = 420;
    };


}).GetHtml()
