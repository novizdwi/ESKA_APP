        column.Caption = "Netto";
        column.Settings.AllowSort = DefaultBoolean.False;
       // column.ReadOnly = true;
        column.Width = 120;

        column.SetDataItemTemplateContent(c =>
        {
            var visibleIndex = c.VisibleIndex;
            var detId = DataBinder.Eval(c.DataItem, "DetId");
            var quantity = DataBinder.Eval(c.DataItem, "Netto");

            Html.DevExpress().ButtonEdit(s =>
            {
                s.Name = "gvGoodsReceiptPoContentDetail_Netto_" + visibleIndex;
                s.Properties.ClientInstanceName = "gGoodsReceiptPoContentDetail_Netto_" + visibleIndex;

                // tampilkan value
                s.Text = Convert.ToDecimal(quantity).ToString("N0");

                s.ReadOnly = true;
                s.Width = 100;

                s.Properties.Buttons.Clear();

                EditButton btn = new EditButton();
                btn.Text = "";
                btn.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                btn.Image.Width = 15;

                s.Properties.Buttons.Add(btn);

                s.Properties.ClientSideEvents.ButtonClick = string.Format("function(s, e) {{ BtnCflNettoPopupListOnClick(s, e, '{0}'); }}", detId);

            }).Render();
        });
