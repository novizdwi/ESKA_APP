@using Models;
@{
    var Id = Convert.ToInt64(Request["cbId"]);

    if (ViewBag.Id != null)
    {
        Id = ViewBag.Id;
    }
    
    ViewBag.ReadOnly = false;
    string status = Models._Ef.DbProvider.dbApp.Database.SqlQuery<string>("SELECT TOP 1 T0.\"Status\" FROM \"Tx_InventoryTransfer\" T0 WHERE T0.\"Id\"=:p0", Id).FirstOrDefault();
    if (status != "Draft")
    {
        ViewBag.ReadOnly = true;
    }
}

@Html.DevExpress().GridView(settings =>
{
    settings.Name = "gvDetail";
    settings.KeyFieldName = "DetId";

    settings.CallbackRouteValues = new { Controller = "InventoryTransfer", Action = "TabDetailListPartial" };

    /* ===== FIX FOOTER ALIGNMENT ===== */
    settings.Settings.UseFixedTableLayout = true;
    settings.SettingsBehavior.ColumnResizeMode = ColumnResizeMode.Control;
    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Visible;
    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;
    /* ================================= */

    settings.Width = Unit.Percentage(100);
    settings.Height = Unit.Percentage(100);

    settings.CommandColumn.Visible = !ViewBag.ReadOnly;
    settings.CommandColumn.Width = 70;
    settings.CommandColumn.ShowDeleteButton = true;
    settings.CommandColumn.ShowNewButtonInHeader = false;
    settings.Enabled = true;

    settings.SettingsEditing.Mode = GridViewEditingMode.Batch;
    settings.SettingsPager.Mode = GridViewPagerMode.ShowAllRecords;
    settings.SettingsEditing.BatchEditSettings.EditMode = GridViewBatchEditMode.Row;
    settings.SettingsEditing.BatchEditSettings.StartEditAction = GridViewBatchStartEditAction.Click;
    settings.SettingsEditing.NewItemRowPosition = GridViewNewItemRowPosition.Bottom;
    settings.Styles.Header.Wrap = DevExpress.Utils.DefaultBoolean.True;

    settings.Settings.ShowFilterRow = false;
    settings.Settings.ShowFilterRowMenu = false;


    settings.Settings.ShowStatusBar = GridViewStatusBarMode.Hidden;
    settings.Columns.Add("Id", "Id").Visible = false;
    settings.Columns.Add("DetId", "DetId").Visible = false;

    settings.Columns.Add(column =>
    {
        column.FieldName = "RowNo";
        column.Name = "RowNo";
        column.Caption = "No.";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 50;
        column.ReadOnly = true;
        column.Settings.AllowSort = DefaultBoolean.True;
        column.Settings.AllowAutoFilter = DefaultBoolean.False;

        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

    });


    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemCode";
        column.Name = "ItemCode";
        column.Caption = "Item Code";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 150;
        column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ItemName";
        column.Name = "ItemName";
        column.Caption = "Item Name";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 250;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "FromWhsCode";
        column.Name = "FromWhsCode";
        column.Caption = "From Whse";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 100;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "ToWhsCode";
        column.Name = "ToWhsCode";
        column.Caption = "To Whse";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 100;
        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

    });



    settings.Columns.Add(column =>
    {
        column.FieldName = "Quantity";
        column.Name = "Quantity";
        column.Caption = "Quantity";
        column.Settings.AllowSort = DefaultBoolean.False;
        column.ReadOnly = true;
        column.Width = 120;

        column.SetDataItemTemplateContent(c =>
        {
            var visibleIndex = c.VisibleIndex;
            var detId = DataBinder.Eval(c.DataItem, "DetId");
            var quantity = DataBinder.Eval(c.DataItem, "Quantity");

            Html.DevExpress().ButtonEdit(s =>
            {
                s.Name = "gInventoryTransferContentDetail_Quantity_" + visibleIndex;
                s.Properties.ClientInstanceName = "gInventoryTransferContentDetail_Quantity_" + visibleIndex;

                // tampilkan value
                s.Text = Convert.ToDecimal(quantity).ToString("N0");

                s.ReadOnly = true;
                s.Width = 100;

                s.Properties.Buttons.Clear();

                EditButton btn = new EditButton();
                btn.Text = "";
                btn.Image.Url = "~/Content/Images/buttonnew/find-hitam.png";
                btn.Image.Width = 15;

                s.Properties.Buttons.Add(btn);

                s.Properties.ClientSideEvents.ButtonClick = string.Format("function(s, e) {{ BtnCflQuantityPopupListOnClick(s, e, '{0}'); }}", detId);

            }).Render();
        });
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Netto";
        column.Name = "Netto";
        column.Caption = "Netto";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 100;

        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

        ASPxSummaryItem summary = new ASPxSummaryItem();
        summary.FieldName = column.FieldName;
        summary.SummaryType = DevExpress.Data.SummaryItemType.Sum;
        summary.DisplayFormat = "{0:#,###}";
        settings.TotalSummary.Add(summary);
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "UomEntry";
        column.Name = "UomEntry";
        column.Caption = "Uom Entry";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 0;

        column.ReadOnly = true;
        column.PropertiesEdit.Style.BackColor = System.Drawing.Color.FromName("#EDEDED");

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;

        ASPxSummaryItem summary = new ASPxSummaryItem();
        summary.FieldName = column.FieldName;
        summary.SummaryType = DevExpress.Data.SummaryItemType.Sum;
        summary.DisplayFormat = "{0:#,###}";
        settings.TotalSummary.Add(summary);
    });

    settings.Columns.Add(column =>
    {
        column.FieldName = "Uom";
        column.Name = "Uom";
        column.Caption = "Uom";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 150;

        column.ReadOnly = !ViewBag.ReadOnly;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");

    });




    settings.Columns.Add(column =>
    {
        column.FieldName = "FreeText";
        column.Name = "FreeText";
        column.Caption = "Free Text";

        column.ColumnType = MVCxGridViewColumnType.TextBox;
        column.Width = 300;

        column.ReadOnly = ViewBag.ReadOnly;

        var txt = column.PropertiesEdit as TextBoxProperties;
        txt.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
        txt.ReadOnlyStyle.BackColor = System.Drawing.Color.FromName("#EDEDED");

    });

    settings.Settings.ShowFooter = true;

    settings.ClientSideEvents.BeginCallback = "gvDetailOnBeginCallback";
    settings.ClientSideEvents.EndCallback = "gvDetailOnEndCallback";

    settings.ClientSideEvents.BatchEditStartEditing = "gvDetailOnBatchEditStartEditing";
    settings.ClientSideEvents.BatchEditEndEditing = "gvDetailOnBatchEditEndEditing";
    settings.ClientSideEvents.BatchEditRowValidating = "gvDetailOnBatchEditRowValidating";

}).Bind(Model).GetHtml()

