@using Models._Utils;

@{
    GridViewModel viewModel = Model;

    var cpGvFind_FilterExpression = GetSqlFromGridViewModelState.getHanaCriteria(viewModel);
    var cpGvFind_SortExpression = GetSqlFromGridViewModelState.getHanaSort(viewModel);
    var cpGvFind_PageIndex = viewModel.Pager.PageIndex;
    var cpGvFind_PageSize = viewModel.Pager.PageSize;

    string cpGvFind_WoType = "";
    string cpGvFind_WoName = "";
    string cpGvFind_WoHeader = "";
    string cpGvFind_WoSqlWhere = "";

    if (Request["hidden_WoType"] != null)
    {
        cpGvFind_WoType = Request["hidden_WoType"];
    }
    if (Request["hidden_WoName"] != null)
    {
        cpGvFind_WoName = Request["hidden_WoName"];
    }
    if (Request["hidden_WoHeader"] != null)
    {
        cpGvFind_WoHeader = Request["hidden_WoHeader"];
    }
    if (Request["hidden_WoSqlWhere"] != null)
    {
        cpGvFind_WoSqlWhere = Request["hidden_WoSqlWhere"];
    }
}

@Html.DevExpress().GridView(settings =>
{
    settings.Name = "gvWorkOrderList";
    settings.KeyFieldName = "BaseEntry";
    settings.CallbackRouteValues = new { Controller = "IssueAndReceipt", Action = "WorkOrderListPartial" };

    settings.Columns.Add(column =>
    {
        column.Caption = "#";

        column.SetDataItemTemplateContent(c =>
        {
            ViewContext.Writer.Write(

                Html.DevExpress().HyperLink(settingsHL =>
                {
                    settingsHL.Name = "WorkOrderChoose_" + DataBinder.Eval(c.DataItem, "BaseEntry") + "_" + Guid.NewGuid().ToString();
                    settingsHL.NavigateUrl = "javascript:void(0)";
                    settingsHL.Properties.Text = "Choose";
                    settingsHL.Properties.ClientSideEvents.Click = string.Format("function(s, e) {{ OnClickChoose_WorkOrder(s, e, {0}); }}", new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(c.DataItem));
                }).GetHtml()

            );
        });
        column.SetHeaderTemplateContent(c =>
        {
            ViewContext.Writer.Write("#Action#");
        });

        column.Settings.AllowDragDrop = DefaultBoolean.False;
        column.Settings.AllowSort = DefaultBoolean.False;
        column.Width = 70;
    });

    settings.Settings.ShowFilterRow = true;
    settings.Settings.ShowFilterRowMenu = true;

    settings.Columns.Add("BaseProcessCardTransNo", "No Wo").Width = 140;
    settings.Columns.Add("BaseProcessCardRoutingName", "Route Stage").Width = 200;
    settings.Columns.Add("BaseProcessCardOperatorName", "Operator").Width = 180;

    settings.SettingsPager.Position = PagerPosition.Bottom;
    settings.SettingsPager.FirstPageButton.Visible = true;
    settings.SettingsPager.LastPageButton.Visible = true;
    settings.SettingsPager.AlwaysShowPager = true;
    settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

    if (cpGvFind_PageIndex == 0)
    {
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
    }

    settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "10", "20", "50" };

    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Visible;

    settings.SettingsBehavior.AllowFocusedRow = true;
    settings.Settings.ShowFilterBar = GridViewStatusBarMode.Hidden;

    settings.CustomBindingRouteValuesCollection.Add(
        GridViewOperationType.Paging,
        new { Controller = "IssueAndReceipt", Action = "WorkOrderListPaging" }
    );

    settings.CustomBindingRouteValuesCollection.Add(
        GridViewOperationType.Filtering,
        new { Controller = "IssueAndReceipt", Action = "WorkOrderListFiltering" }
    );

    settings.CustomBindingRouteValuesCollection.Add(
        GridViewOperationType.Sorting,
        new { Controller = "IssueAndReceipt", Action = "WorkOrderListSorting" }
    );

    settings.CustomJSProperties = (sender, e) =>
    {
        e.Properties["cpGvFind_FilterExpression"] = cpGvFind_FilterExpression;
        e.Properties["cpGvFind_SortExpression"] = cpGvFind_SortExpression;
        e.Properties["cpGvFind_PageIndex"] = cpGvFind_PageIndex;
        e.Properties["cpGvFind_PageSize"] = cpGvFind_PageSize;
        e.Properties["cpGvFind_WoType"] = cpGvFind_WoType;
        e.Properties["cpGvFind_WoName"] = cpGvFind_WoName;
        e.Properties["cpGvFind_WoHeader"] = cpGvFind_WoHeader;
        e.Properties["cpGvFind_WoSqlWhere"] = cpGvFind_WoSqlWhere;
    };

    settings.ClientSideEvents.BeginCallback = "function(s, e) { e.customArgs['hidden_WoType']=s.cpGvFind_WoType; e.customArgs['hidden_WoName']=s.cpGvFind_WoName; e.customArgs['hidden_WoHeader']=s.cpGvFind_WoHeader; e.customArgs['hidden_WoSqlWhere']=s.cpGvFind_WoSqlWhere; }";

    foreach (GridViewDataColumn column in settings.Columns)
    {
        column.Settings.AllowAutoFilterTextInputTimer = DevExpress.Utils.DefaultBoolean.False;
    }

    settings.BeforeGetCallbackResult = (sender, e) =>
    {
        MVCxGridView gridView = sender as MVCxGridView;
        Models._Utils.General.GridViewFilterExpression(gridView, settings);
    };

}).BindToCustomData(Model).GetHtml()
