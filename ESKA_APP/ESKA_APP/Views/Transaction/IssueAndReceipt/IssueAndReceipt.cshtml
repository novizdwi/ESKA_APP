    function btnShowCancelReasonOnClick(s, e, Id) {
        var popup = ASPxClientPopupControl.Cast("popupCancelReason");

        popup.callbackUrl = '@Url.Action("CancelReason_PopupListOnDemandPartial", "IssueAndReceipt")' + '?Id=' + Id;
        popup.PerformCallback();

        if (!popup.IsVisible()) {
            loadingPanel.Show();
        }
    }
    ///-------------------------------------FORM CANCEL-----------------------------------///

    function GetFormData() {
        var formData = $('#formDetail').serializeObject();

        //var Details_ = GetGvDetails('gvIssueAndReceiptDetail');
